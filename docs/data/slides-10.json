[{"id": 1, "title": "AQI 資料專題", "chapter": "封面", "bg": "navy", "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>🌫️</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>空氣品質資料專題</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>API · JSON · AQI · Gradio · Final Project</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🔌 API</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🗂️ JSON</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>📮 自動通知</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🖥️ Gradio 互動網頁</span></div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>城市科技 · 高一第二學期 ｜ 第 13–15 週</p>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 2, "title": "專題情境", "chapter": "第一節：API 與 JSON", "bg": "white", "html": "<h2 class='slide-title'>🏃 情境：今天體育課要不要改在室內？</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>體育老師每天早上都要上網查空氣品質。能不能寫一支程式，<strong>自動抓資料、判斷、通知</strong>，甚至做成網頁讓全校查？</p></div>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdfa;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#0d9488;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#115e59;font-size:.88rem;'>取得資料</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>呼叫環境部的 AQI API（本節）</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdfa;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#0d9488;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#115e59;font-size:.88rem;'>分析資料</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>用 Pandas 找出學校附近測站（第二節）</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdfa;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#0d9488;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#115e59;font-size:.88rem;'>自動通知</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>超過門檻就寄信（第三節）</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdfa;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#0d9488;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>4</div><div><strong style='color:#115e59;font-size:.88rem;'>互動網頁</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>用 Gradio 做「空氣品質查詢器」（第三節）</div></div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 3, "title": "什麼是 API", "chapter": "第一節：API 與 JSON", "bg": "white", "html": "<h2 class='slide-title'>🔌 API：程式和程式之間的點餐窗口</h2>\n<div style='display:grid;grid-template-columns:1fr 1.3fr;gap:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🍔</div><strong style='color:#1e40af;font-size:.9rem;'>比喻：速食店點餐</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>你不用進廚房，只要在窗口<strong>照規定點餐</strong>（送出網址＋參數），店員就把餐點<strong>照固定格式</strong>交給你（JSON 資料）。</div></div><table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:58%;'>網址的部分</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:42%;'>意思</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>https://data.moenv.gov.tw/api/v2/aqx_p_432</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>資料集：空氣品質指標(AQI)</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>?api_key=…</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>你的通行證</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>&limit=1000</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>最多回傳幾筆</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>&format=JSON</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>回傳格式</td></tr></table>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🇹🇼 環境部「環境資料開放平臺」提供 AQI 每小時更新的資料。使用前要先<strong>註冊會員取得 API Key</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 4, "title": "保護 API Key", "chapter": "第一節：API 與 JSON", "bg": "white", "html": "<h2 class='slide-title'>🔑 API Key 和密碼一樣，不能外流</h2>\n<div style='display:grid;grid-template-columns:1fr 1.3fr;gap:12px;'><div style='background:#fef2f2;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🙅</div><strong style='color:#991b1b;font-size:.9rem;'>❌ 危險寫法</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>API_KEY = &quot;a1b2c3…&quot;</code><br>寫在程式碼裡，分享 Colab 給別人時就被看光了。</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🔐</div><strong style='color:#166534;font-size:.9rem;'>✅ 用 Colab Secrets</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>左側 🔑 圖示 → 新增密鑰 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>MOENV_API_KEY</code> → 開啟存取權<br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>from google.colab import userdata</code><br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>API_KEY = userdata.get(&quot;MOENV_API_KEY&quot;)</code></div></div></div>\n<div style='background:#fef2f2;padding:11px 16px;border-radius:8px;border-left:4px solid #dc2626;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🛡️ 資安習慣：金鑰、密碼、個資<strong>不寫進程式、不貼到群組、不上傳到公開的 GitHub</strong>。外流了就到平臺重新產生一組。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 5, "title": "JSON 格式", "chapter": "第一節：API 與 JSON", "bg": "white", "html": "<h2 class='slide-title'>🗂️ JSON：字典和串列組成的資料</h2>\n<div style='display:grid;grid-template-columns:1.3fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>API 回傳資料的樣子（示意，數字非實際資料）</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>{\n  &quot;total&quot;: &quot;84&quot;,\n  &quot;records&quot;: [\n    {&quot;sitename&quot;: &quot;古亭&quot;, &quot;county&quot;: &quot;臺北市&quot;,\n     &quot;aqi&quot;: &quot;45&quot;, &quot;status&quot;: &quot;良好&quot;, &quot;pm2.5&quot;: &quot;9&quot;},\n    {&quot;sitename&quot;: &quot;萬華&quot;, &quot;county&quot;: &quot;臺北市&quot;,\n     &quot;aqi&quot;: &quot;52&quot;, &quot;status&quot;: &quot;普通&quot;, &quot;pm2.5&quot;: &quot;14&quot;}\n  ]\n}</pre></div></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:45%;'>符號</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:55%;'>Python 對應</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>{ \"鍵\": 值 }</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>字典 dict</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>[ … ]</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>串列 list</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>\"文字\"</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>字串 str（注意 aqi 也是字串！）</td></tr></table>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 取值：<code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>data[&quot;records&quot;][0][&quot;sitename&quot;]</code> → 先取字典的 records（一個串列），再取索引 0，再取 sitename。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 6, "title": "呼叫 API", "chapter": "第一節：API 與 JSON", "bg": "white", "html": "<h2 class='slide-title'>💻 用 requests 呼叫 API</h2>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>import requests\nfrom google.colab import userdata\n\nAPI_KEY = userdata.get(&quot;MOENV_API_KEY&quot;)\nurl = f&quot;https://data.moenv.gov.tw/api/v2/aqx_p_432?api_key={API_KEY}&amp;limit=1000&amp;format=JSON&quot;\ndata = requests.get(url, timeout=30).json()\nrecords = data[&quot;records&quot;]\nprint(&quot;測站數：&quot;, len(records))\nfor rec in records[:3]:\n    print(rec[&quot;county&quot;], rec[&quot;sitename&quot;], rec[&quot;aqi&quot;], rec[&quot;status&quot;])</pre></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧯 出錯時先 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>print(data)</code> 看回傳了什麼：常見原因是 API Key 沒設定、網址打錯、平臺維護中。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 7, "title": "第一節 隨堂測驗", "chapter": "第一節：API 與 JSON", "bg": "purple", "quiz": "q1", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>API 與 JSON ｜ 4 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 8, "title": "AQI 分級", "chapter": "第二節：AQI 資料分析", "bg": "white", "html": "<h2 class='slide-title'>🚦 空氣品質指標 AQI 分級</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:14%;'>AQI</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:26%;'>狀態</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:14%;'>顏色</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:46%;'>活動建議（一般民眾）</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>0–50</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>良好</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🟢 綠</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>正常戶外活動</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>51–100</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>普通</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🟡 黃</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>極特殊敏感族群注意</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>101–150</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>對敏感族群不健康</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🟠 橘</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>有症狀者減少體力消耗活動</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>151–200</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>對所有族群不健康</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🔴 紅</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>減少戶外活動</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>201–300</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>非常不健康</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🟣 紫</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>減少外出</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>301–500</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>危害</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🟤 褐紅</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>避免外出</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 📚 AQI 依 O₃、PM2.5、PM10、CO、SO₂、NO₂ 等污染物濃度換算，取最大的那一項。分級依環境部空氣品質指標說明。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 9, "title": "轉成 DataFrame", "chapter": "第二節：AQI 資料分析", "bg": "white", "html": "<h2 class='slide-title'>📋 把 JSON 變成 DataFrame</h2>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>import pandas as pd\ndf = pd.DataFrame(records)\ndf[&quot;aqi&quot;] = pd.to_numeric(df[&quot;aqi&quot;], errors=&quot;coerce&quot;)\ndf = df.dropna(subset=[&quot;aqi&quot;])\ndf[[&quot;county&quot;, &quot;sitename&quot;, &quot;aqi&quot;, &quot;status&quot;, &quot;pm2.5&quot;, &quot;publishtime&quot;]].head()</pre></div></div>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#fefce8;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🔢</div><strong style='color:#854d0e;font-size:.9rem;'>pd.to_numeric(…, errors=\"coerce\")</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>API 給的 aqi 是<strong>字串</strong>，要轉成數字才能比大小、排序。轉不了的（例如測站維修沒資料）變成 NaN。</div></div><div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🧹</div><strong style='color:#1e40af;font-size:.9rem;'>dropna(subset=[\"aqi\"])</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>把 aqi 是 NaN 的列刪掉，這就是<strong>資料清理</strong>。</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 10, "title": "找出學校附近", "chapter": "第二節：AQI 資料分析", "bg": "white", "html": "<h2 class='slide-title'>🏫 分析：臺北市、全臺最高、學校附近</h2>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'># 臺北市各測站 AQI 由高到低\ntpe = df[df[&quot;county&quot;] == &quot;臺北市&quot;].sort_values(&quot;aqi&quot;, ascending=False)\nprint(tpe[[&quot;sitename&quot;, &quot;aqi&quot;, &quot;status&quot;]])\n\n# 全臺 AQI 最高的 5 站\nprint(df.nlargest(5, &quot;aqi&quot;)[[&quot;county&quot;, &quot;sitename&quot;, &quot;aqi&quot;]])\n\n# 學校附近：古亭站\naqi = df[df[&quot;sitename&quot;] == &quot;古亭&quot;][&quot;aqi&quot;].values[0]\nprint(&quot;古亭 AQI&quot;, aqi)</pre></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🗺️ 芳和實中在臺北市大安區，較近的環境部測站有古亭、松山等；可以到「空氣品質監測網」地圖上確認距離最近的測站。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 11, "title": "校內空氣盒子", "chapter": "第二節：AQI 資料分析", "bg": "white", "html": "<h2 class='slide-title'>📦 校內空氣盒子：LASS 開源感測資料</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;'><div style='background:#f0fdfa;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>⚖️</div><strong style='color:#115e59;font-size:.9rem;'>兩種資料比一比</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><strong>環境部測站</strong>：精密儀器、數量少、可信度高<br><br><strong>空氣盒子</strong>：低成本感測器、數量多、更貼近身邊，但有誤差、可能斷線</div></div><div style='background:#fff7ed;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🩺</div><strong style='color:#9a3412;font-size:.9rem;'>資料的「健康檢查」</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>① 有沒有資料？（盒子斷電就沒有）<br>② 時間對嗎？（API 給 UTC 時間，要 +8 小時）<br>③ 數值合理嗎？（PM2.5 是負數或幾千就有問題）</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🔬 比較同一時間「校內盒子」和「最近測站」的 PM2.5，差多少？為什麼會不同？——這就是資料素養。Colab 第 10 課有範例程式。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 12, "title": "第二節 隨堂測驗", "chapter": "第二節：AQI 資料分析", "bg": "purple", "quiz": "q2", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>AQI 資料分析 ｜ 4 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 13, "title": "自動通知", "chapter": "第三節：通知與互動網頁", "bg": "white", "html": "<h2 class='slide-title'>📮 超過門檻就自動寄信</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>用到第 3 章的 if 和第 8 章的函式</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>if aqi &gt; 100:\n    send_email(&quot;AQI 警示&quot;,\n               f&quot;古亭 AQI {aqi}，建議體育課改室內&quot;,\n               收件人)\nelse:\n    print(&quot;古亭 AQI&quot;, aqi, &quot;空氣品質尚可&quot;)</pre></div></div>\n<div style='background:#fefce8;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📢</div><strong style='color:#854d0e;font-size:.9rem;'>通知管道的變化</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>舊範例用 <strong>LINE Notify</strong>，但它已在 <strong>2025 年 3 月 31 日停止服務</strong>，程式就不能用了。<br><br>這次改用 Gmail（需建立「應用程式密碼」，並存在 Colab Secrets）。</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 學到的教訓：依賴外部服務的程式，<strong>服務會改版、會收掉</strong>。寫程式時把「寄通知」包成函式，要換管道只改一個地方。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 14, "title": "Gradio 介紹", "chapter": "第三節：通知與互動網頁", "bg": "white", "html": "<h2 class='slide-title'>🖥️ Gradio：三行把函式變成網頁</h2>\n<div style='display:grid;grid-template-columns:1.3fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>先執行 !pip -q install gradio</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>import gradio as gr\n\ndef bmi(h, w):\n    b = w / (h / 100) ** 2\n    return f&quot;你的 BMI 是 {b:.2f}&quot;\n\ngr.Interface(bmi,\n    inputs=[gr.Number(label=&quot;身高（公分）&quot;),\n            gr.Number(label=&quot;體重（公斤）&quot;)],\n    outputs=&quot;text&quot;,\n    title=&quot;BMI 小幫手&quot;).launch()</pre></div></div>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#f5f3ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#7c3aed;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#5b21b6;font-size:.88rem;'>寫一個函式</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>參數 = 使用者輸入，return = 顯示的結果</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f5f3ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#7c3aed;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#5b21b6;font-size:.88rem;'>gr.Interface</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>告訴 Gradio 有哪些輸入框、輸出什麼</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f5f3ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#7c3aed;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#5b21b6;font-size:.88rem;'>.launch()</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>Colab 會顯示網頁，並給一個暫時的分享網址</div></div></div></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🔁 第 3 章的 BMI 程式，加上 Gradio 就變成同學可以用手機開的網頁——這就是「<strong>與人互動</strong>」的程式。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 15, "title": "空氣品質查詢器", "chapter": "第三節：通知與互動網頁", "bg": "white", "html": "<h2 class='slide-title'>🔍 實作：空氣品質查詢器</h2>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>def query(site):\n    row = df[df[&quot;sitename&quot;] == site.strip()]\n    if row.empty:\n        return &quot;查無此測站&quot;\n    a = int(row[&quot;aqi&quot;].values[0])\n    if a &lt;= 50:\n        tip = &quot;適合戶外活動&quot;\n    elif a &lt;= 100:\n        tip = &quot;普通，敏感族群留意&quot;\n    else:\n        tip = &quot;建議減少戶外活動&quot;\n    return f&quot;{site} AQI {a}（{row[&#x27;status&#x27;].values[0]}）— {tip}&quot;\n\ngr.Interface(query, inputs=gr.Textbox(label=&quot;測站名稱&quot;),\n             outputs=&quot;text&quot;, title=&quot;空氣品質查詢器&quot;).launch()</pre></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧩 整學期的觀念全部用上：<strong>函式、if-elif、字串、Pandas 篩選、f-string</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 16, "title": "把資料用對", "chapter": "第三節：通知與互動網頁", "bg": "white", "html": "<h2 class='slide-title'>⚖️ 負責任地使用資料與程式</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📝</div><strong style='color:#1e40af;font-size:.9rem;'>註明來源與時間</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>「資料來源：環境部環境資料開放平臺，2026/11/4 10:00 取得」</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>⚠️</div><strong style='color:#166534;font-size:.9rem;'>說清楚限制</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>空氣盒子有誤差、測站不在學校正上方、資料每小時才更新</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🔕</div><strong style='color:#854d0e;font-size:.9rem;'>不要造成恐慌</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>寄通知的門檻和措辭要合理，不誇大</div></div><div style='background:#fef2f2;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🔐</div><strong style='color:#991b1b;font-size:.9rem;'>保護金鑰與個資</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>分享 Colab 前檢查有沒有 API Key、Email 密碼</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 17, "title": "第三節 隨堂測驗", "chapter": "第三節：通知與互動網頁", "bg": "purple", "quiz": "q3", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>通知與互動網頁 ｜ 4 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 18, "title": "期末專題任務", "chapter": "期末專題", "bg": "white", "html": "<h2 class='slide-title'>🎯 期末專題：用 Python 做一個「與人互動」的資料小工具</h2>\n<div style='display:flex;align-items:center;gap:14px;background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:12px 16px;margin-bottom:12px;'><div style='font-size:2rem;'>📓</div><div style='flex:1;'><strong style='color:#9a3412;font-size:.9rem;'>第 10 課 Colab：AQI 專題範例</strong><div style='font-size:.78rem;color:#475569;margin-top:4px;line-height:1.6;'>API 呼叫、JSON 解析、Pandas 分析、空氣盒子、Gmail 通知、Gradio 查詢器<br>🔐 請用學校 Google 帳號登入才能開啟。</div></div><a href='https://colab.research.google.com/drive/1_pK8QML46AsdEDGQ-_cYfVqJBhOBrgvu' target='_blank' rel='noopener' style='background:#f9ab00;color:#1f2937;font-weight:700;font-size:.82rem;padding:9px 16px;border-radius:20px;text-decoration:none;white-space:nowrap;'>在 Colab 開啟 ↗</a></div>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>① 取得資料</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>API 或開放資料檔，註明來源與取得時間</div></div><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>② 處理資料</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>至少 1 個篩選或統計</div></div><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>③ 呈現結果</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>1 張圖表或 1 個 Gradio 介面</div></div><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>④ 文字說明</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>動機、做法、發現、困難</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 💡 主題自選：AQI、YouBike、天氣、公車、校內空氣盒子、圖書館…。2～3 人一組，繳交 Colab 共用連結（檢視者權限）＋ 1 分鐘展示。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 19, "title": "專題評分規準", "chapter": "期末專題", "bg": "white", "html": "<h2 class='slide-title'>📏 期末專題評分規準</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>向度</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>A</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>B</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>C</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>D</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>資料取得（20%）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>使用 API 或即時資料，來源、時間完整</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>使用開放資料檔，有註明來源</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>有資料但來源不清楚</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>沒有真實資料</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>程式設計（35%）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>程式正確、有函式與註解、有處理錯誤情況</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>程式正確可執行</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>部分功能有誤</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>無法執行</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>呈現與互動（25%）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Gradio 介面或圖表清楚、易用</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>有圖表或介面</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>呈現不清楚</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>沒有呈現</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>說明與展示（20%）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>能說明發現與資料限制</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>能說明做法</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>說明不完整</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>未說明</td></tr></table>\n", "quiz": null, "chart": null, "video": null}, {"id": 20, "title": "學期總結", "chapter": "期末專題", "bg": "navy", "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 這學期你學會了</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>基礎語法</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>輸出入、變數、運算、選擇、迴圈</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>資料結構與演算法</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>串列、二維串列、排序、搜尋、遞迴</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>模組化</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>函式：把問題拆小、包成工具</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>資料應用</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>Pandas、API、Gradio：用程式解決真實問題</p></div></div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>Stay Hungry, Stay Foolish ！</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>從 print(\"Hello\") 到空氣品質查詢器——第 3 學期見：工程設計！</p>\n</div>\n", "quiz": null, "chart": null, "video": null}]