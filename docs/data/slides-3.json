[{"id": 1, "title": "循序與選擇結構", "chapter": "封面", "bg": "navy", "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>🔀</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>讓程式學會判斷</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Sequence &amp; Selection Structures</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>➡️ 循序</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🔁 兩數交換</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>❓ if / else</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🪜 elif 多重選擇</span></div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>城市科技 · 高一第二學期 ｜ 第 3 週</p>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 2, "title": "三種基本結構", "chapter": "第一節：結構化程式與循序結構", "bg": "white", "html": "<h2 class='slide-title'>🧱 結構化程式設計：只用三種結構</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>➡️</div><strong style='color:#1e40af;font-size:.9rem;'>循序 Sequence</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>一步一步、由上往下執行</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🔀</div><strong style='color:#854d0e;font-size:.9rem;'>選擇 Selection</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>依條件決定走哪條路<br>if / elif / else</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🔁</div><strong style='color:#166534;font-size:.9rem;'>重複 Repetition</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>條件成立就反覆執行<br>for / while（下週）</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 1966 年 Böhm 與 Jacopini 證明：<strong>任何演算法都能只用這三種結構組合出來</strong>。七年級學過的 Scratch 也是同樣的三種結構。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 3, "title": "流程圖複習", "chapter": "第一節：結構化程式與循序結構", "bg": "white", "html": "<h2 class='slide-title'>🗺️ 流程圖符號複習</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;'><div style='display:flex;flex-direction:column;align-items:flex-start;gap:0;'><div style='display:flex;align-items:center;'><div style='width:240px;display:flex;justify-content:center;'><div style='border-radius:999px;background:#1e3a5f;color:#fff;width:180px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>開始</div></div></div><div style='width:240px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:240px;display:flex;justify-content:center;'><div style='clip-path:polygon(10% 0,100% 0,90% 100%,0 100%);background:#dcfce7;color:#14532d;width:180px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>輸入半徑 r</div></div></div><div style='width:240px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:240px;display:flex;justify-content:center;'><div style='border-radius:4px;background:#dbeafe;color:#1e3a8a;width:180px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>area = 3.14 * r * r</div></div></div><div style='width:240px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:240px;display:flex;justify-content:center;'><div style='clip-path:polygon(10% 0,100% 0,90% 100%,0 100%);background:#dcfce7;color:#14532d;width:180px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>輸出 area</div></div></div><div style='width:240px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:240px;display:flex;justify-content:center;'><div style='border-radius:999px;background:#1e3a5f;color:#fff;width:180px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>結束</div></div></div></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:40%;'>形狀</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:60%;'>意義</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>橢圓</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>開始／結束</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>平行四邊形</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>輸入／輸出</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>矩形</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>處理（計算、指定）</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>菱形</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>判斷（是／否兩條路）</td></tr></table>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 ✏️ 左邊就是上週「圓面積」程式的流程圖——只有循序結構，從上到下一路走完。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 4, "title": "兩數交換", "chapter": "第一節：結構化程式與循序結構", "bg": "white", "html": "<h2 class='slide-title'>🔄 循序結構的經典：兩數交換</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;'><div style='background:#fef2f2;padding:14px;border-radius:10px;'><strong style='color:#991b1b;font-size:.9rem;'>❌ 錯誤寫法</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>x = y</code><br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>y = x</code><br><br>x 原本的值被蓋掉了，兩個變數最後一樣。</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><strong style='color:#166534;font-size:.9rem;'>✅ 用暫存變數 t</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>t = x</code>　先把 x 存起來<br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>x = y</code><br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>y = t</code>　再把原本的 x 給 y</div></div></div>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>想像兩杯飲料要互換，需要第三個空杯</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>x, y = 1, 0\nt = x\nx = y\ny = t\nprint(x, y)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>0 1</pre></div></div>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>x, y = 1, 0\nx, y = y, x      # Python 專屬的簡潔寫法\nprint(x, y)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>0 1</pre></div></div>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 5, "title": "追蹤程式", "chapter": "第一節：結構化程式與循序結構", "bg": "white", "html": "<h2 class='slide-title'>🔍 用追蹤表看懂程式</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>追蹤表（trace table）：每執行一行，就記下每個變數的值。這是除錯和寫 APCS 觀念題最有用的方法。</p></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:40%;'>執行的程式</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>x</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>y</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>t</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>x, y = 1, 0</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>0</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>—</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>t = x</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>0</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>x = y</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>0</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>0</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>y = t</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>0</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'><strong>1</strong></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 📌 每一列只改變「等號左邊」那個變數，其他照抄上一列。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 6, "title": "第一節 隨堂測驗", "chapter": "第一節：結構化程式與循序結構", "bg": "purple", "quiz": "q1", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>結構化程式與循序結構 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 7, "title": "if 語法", "chapter": "第二節：if 與 if-else", "bg": "white", "html": "<h2 class='slide-title'>❓ if：條件成立才執行</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>age = int(input(&quot;年齡：&quot;))\nif age &gt;= 18:\n    print(&quot;你的年齡&quot;, age)\n    print(&quot;成年&quot;)\nprint(&quot;謝謝使用&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>年齡：20\n你的年齡 20\n成年\n謝謝使用</pre></div></div>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#fefce8;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#f59e0b;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#854d0e;font-size:.88rem;'>條件式後加冒號 :</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>忘了冒號會出現 SyntaxError</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#fefce8;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#f59e0b;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#854d0e;font-size:.88rem;'>區塊要縮排</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>同一區塊縮排要一樣（常用 4 格空白）</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#fefce8;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#f59e0b;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#854d0e;font-size:.88rem;'>縮排結束 = 區塊結束</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>「謝謝使用」沒有縮排，不管條件都會執行</div></div></div></div>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 8, "title": "縮排的重要", "chapter": "第二節：if 與 if-else", "bg": "white", "html": "<h2 class='slide-title'>📏 縮排錯一格，意思就變了</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>兩行都縮排：條件不成立，兩行都不執行</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>age = 10\nif age &gt;= 18:\n    print(&quot;你的年齡&quot;, age)\n    print(&quot;成年&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'></pre></div></div>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>只縮排一行：「成年」一定會被印出來</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>age = 10\nif age &gt;= 18:\n    print(&quot;你的年齡&quot;, age)\nprint(&quot;成年&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>成年</pre></div></div>\n</div>\n<div style='background:#fef2f2;padding:11px 16px;border-radius:8px;border-left:4px solid #dc2626;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> ⚠️ 第二個程式沒有語法錯誤，卻輸出了錯的結果——這叫<strong>語意錯誤（邏輯錯誤）</strong>，電腦不會提醒你，最難抓！</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 9, "title": "if-else 二選一", "chapter": "第二節：if 與 if-else", "bg": "white", "html": "<h2 class='slide-title'>🔀 if - else：二選一</h2>\n<div style='display:grid;grid-template-columns:1fr 1.1fr;gap:12px;'><div style='display:flex;flex-direction:column;align-items:flex-start;gap:0;'><div style='display:flex;align-items:center;'><div style='width:230px;display:flex;justify-content:center;'><div style='clip-path:polygon(10% 0,100% 0,90% 100%,0 100%);background:#dcfce7;color:#14532d;width:170px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>輸入 n</div></div></div><div style='width:230px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:230px;display:flex;justify-content:center;'><div style='clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%);background:#fef3c7;color:#78350f;width:230px;padding:22px 26px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>n % 2 == 0 ?</div></div><div style='font-size:.75rem;color:#b45309;font-weight:600;margin-left:10px;'>是 → 偶數；否 → 奇數</div></div><div style='width:230px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:230px;display:flex;justify-content:center;'><div style='clip-path:polygon(10% 0,100% 0,90% 100%,0 100%);background:#dcfce7;color:#14532d;width:170px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>輸出結果</div></div></div></div>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>判斷奇偶數</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>n = int(input(&quot;n=&quot;))\nif n % 2 == 0:\n    print(&quot;偶數&quot;)\nelse:\n    print(&quot;奇數&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>n=7\n奇數</pre></div></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 💡 else 後面<strong>不寫條件</strong>，代表「以上都不成立的其他情況」，也要加冒號。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 10, "title": "範例：自動加分", "chapter": "第二節：if 與 if-else", "bg": "white", "html": "<h2 class='slide-title'>🎁 範例：59 分自動加 1 分</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>只有 if、沒有 else 也可以</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>s = int(input(&quot;成績：&quot;))\nif s == 59:\n    s = s + 1\nprint(&quot;最後成績&quot;, s)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>成績：59\n最後成績 60</pre></div></div>\n<div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🤔</div><strong style='color:#1e40af;font-size:.9rem;'>想一想</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>如果改成「55～59 分一律變 60 分」，條件式要怎麼寫？<br><br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>if s &gt;= 55 and s &lt;= 59:</code><br>　<code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>s = 60</code></div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧾 對應線上練習 <strong>#317 自動加 1 元</strong>：題目情境不同，結構完全一樣。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 11, "title": "範例：三數最大", "chapter": "第二節：if 與 if-else", "bg": "white", "html": "<h2 class='slide-title'>🏆 範例：三個數找最大（打擂台法）</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>a, b, c = map(int, input().split())\nmx = a              # 先讓 a 當擂台主\nif b &gt; mx:\n    mx = b\nif c &gt; mx:\n    mx = c\nprint(&quot;最大數&quot;, mx)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>85 92 78\n最大數 92</pre></div></div>\n<div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🥊</div><strong style='color:#166534;font-size:.9rem;'>打擂台法</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>① 先假設第一個最大<br>② 後面的人一個一個上台挑戰<br>③ 比擂台主大就換人<br><br>這個想法第 6 章處理「一整串成績」時會再用到！</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧾 對應線上練習 <strong>#318 計算最高銷量</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 12, "title": "第二節 隨堂測驗", "chapter": "第二節：if 與 if-else", "bg": "purple", "quiz": "q2", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>if 與 if-else ｜ 4 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 13, "title": "if-elif-else", "chapter": "第三節：if-elif-else 多重選擇", "bg": "white", "html": "<h2 class='slide-title'>🪜 if - elif - else：多選一</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>elif ＝ else if。程式<strong>由上往下</strong>檢查，遇到<strong>第一個成立</strong>的條件就執行它，其餘全部跳過。</p></div>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>成績等第</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>s = int(input(&quot;成績：&quot;))\nif s &gt;= 90:\n    print(&quot;優&quot;)\nelif s &gt;= 80:\n    print(&quot;甲&quot;)\nelif s &gt;= 70:\n    print(&quot;乙&quot;)\nelif s &gt;= 60:\n    print(&quot;丙&quot;)\nelse:\n    print(&quot;丁&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>成績：85\n甲</pre></div></div>\n<div style='background:#fefce8;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>💡</div><strong style='color:#854d0e;font-size:.9rem;'>為什麼 elif s >= 80 就夠？</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>能走到這一行，代表上面的 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>s &gt;= 90</code> 不成立，也就是 s &lt; 90 已經確定了，所以不用再寫 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>s &lt; 90</code>。</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 14, "title": "條件的順序", "chapter": "第三節：if-elif-else 多重選擇", "bg": "white", "html": "<h2 class='slide-title'>⚠️ 條件順序寫反會怎樣？</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>從小的條件開始判斷</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>s = 95\nif s &gt;= 60:\n    print(&quot;丙&quot;)\nelif s &gt;= 70:\n    print(&quot;乙&quot;)\nelif s &gt;= 90:\n    print(&quot;優&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>丙</pre></div></div>\n<div style='background:#fef2f2;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>😱</div><strong style='color:#991b1b;font-size:.9rem;'>95 分竟然是丙！</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>因為 95 >= 60 第一個成立，後面就不檢查了。<br><br><strong>規則：用 >= 判斷時，從大的往小的寫</strong>；用 &lt; 判斷時則從小的往大的寫。</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧪 測試時一定要試<strong>邊界值</strong>：剛好 90、89、60、59、0、100。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 15, "title": "範例：購物折扣", "chapter": "第三節：if-elif-else 多重選擇", "bg": "white", "html": "<h2 class='slide-title'>🛍️ 範例：購物節折扣</h2>\n<div style='display:grid;grid-template-columns:1fr 1.3fr;gap:12px;'><table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:55%;'>購物金額</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:45%;'>折扣</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4000 以上</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>8 折</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3000 以上</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>85 折</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>2000 以上</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>9 折</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1000 以上</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>95 折</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>未滿 1000</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>不打折</td></tr></table>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>m = int(input(&quot;購物金額：&quot;))\nif m &gt;= 4000:\n    m = m * 0.8\nelif m &gt;= 3000:\n    m = m * 0.85\nelif m &gt;= 2000:\n    m = m * 0.9\nelif m &gt;= 1000:\n    m = m * 0.95\nprint(&quot;實付&quot;, int(m))</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>購物金額：3200\n實付 2720</pre></div></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧾 對應線上練習 <strong>#319 購物折扣計算</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 16, "title": "範例：BMI", "chapter": "第三節：if-elif-else 多重選擇", "bg": "white", "html": "<h2 class='slide-title'>⚖️ 範例：BMI 判定</h2>\n<div style='display:grid;grid-template-columns:1.3fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>h = float(input(&quot;身高(cm)：&quot;)) / 100\nw = float(input(&quot;體重(kg)：&quot;))\nbmi = w / (h * h)\nprint(f&quot;BMI = {bmi:.2f}&quot;)\nif bmi &lt; 18.5:\n    print(&quot;過輕&quot;)\nelif bmi &lt; 24:\n    print(&quot;正常範圍&quot;)\nelif bmi &lt; 27:\n    print(&quot;過重&quot;)\nelse:\n    print(&quot;肥胖&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>身高(cm)：165\n體重(kg)：55\nBMI = 20.20\n正常範圍</pre></div></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:55%;'>BMI</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:45%;'>判定</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>&lt; 18.5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>過輕</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>18.5 ～ &lt; 24</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>正常範圍</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>24 ～ &lt; 27</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>過重</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>≥ 27</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>肥胖</td></tr></table>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🇹🇼 標準：衛生福利部國民健康署成人肥胖定義。這裡用 &lt; 判斷，所以條件<strong>從小的往大的</strong>寫。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 17, "title": "巢狀 if", "chapter": "第三節：if-elif-else 多重選擇", "bg": "white", "html": "<h2 class='slide-title'>🪆 巢狀 if：if 裡面還有 if</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>a, b, c = map(int, input().split())\nif a + b &gt; c and a + c &gt; b and b + c &gt; a:\n    if a == b == c:\n        print(&quot;正三角形&quot;)\n    elif a == b or b == c or a == c:\n        print(&quot;等腰三角形&quot;)\n    else:\n        print(&quot;一般三角形&quot;)\nelse:\n    print(&quot;無法構成三角形&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>3 3 5\n等腰三角形</pre></div></div>\n<div style='background:#f5f3ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🧩</div><strong style='color:#5b21b6;font-size:.9rem;'>先大後小</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>先判斷「能不能成為三角形」，成立之後才判斷是哪一種。<br><br>縮排的層次就是邏輯的層次：內層的 if 屬於外層 if 的區塊。</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 18, "title": "第三節 隨堂測驗", "chapter": "第三節：if-elif-else 多重選擇", "bg": "purple", "quiz": "q3", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>if-elif-else ｜ 4 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 19, "title": "本週實作", "chapter": "實作與總結", "bg": "white", "html": "<h2 class='slide-title'>✏️ 本週實作：Colab ＋ 線上練習</h2>\n<div style='display:flex;align-items:center;gap:14px;background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:12px 16px;margin-bottom:12px;'><div style='font-size:2rem;'>📓</div><div style='flex:1;'><strong style='color:#9a3412;font-size:.9rem;'>第 3 課 Colab 練習（7 題）</strong><div style='font-size:.78rem;color:#475569;margin-top:4px;line-height:1.6;'>兩數交換、奇偶數、59 分加 1 分、三數最大、成績等第、購物折扣、BMI</div></div><a href='https://colab.research.google.com/github/fhehshs/city-tech-115-2/blob/main/notebooks/py03_if.ipynb' target='_blank' rel='noopener' style='background:#f9ab00;color:#1f2937;font-weight:700;font-size:.82rem;padding:9px 16px;border-radius:20px;text-decoration:none;white-space:nowrap;'>在 Colab 開啟 ↗</a></div>\n<div style='background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:12px 16px;margin-bottom:12px;'><div style='display:flex;justify-content:space-between;align-items:center;gap:10px;'><strong style='color:#166534;font-size:.9rem;'>💻 線上練習（Online Judge）</strong><a href='http://103.226.213.97/course/view.php?id=2109' target='_blank' rel='noopener' style='background:#16a34a;color:#fff;font-weight:700;font-size:.78rem;padding:7px 14px;border-radius:18px;text-decoration:none;white-space:nowrap;'>前往練習網站 ↗</a></div><ul style='margin:8px 0 0 18px;font-size:.8rem;color:#334155;line-height:1.6;'><li style='margin-bottom:3px;'><strong>#314</strong> 循序結構（測驗）</li><li style='margin-bottom:3px;'><strong>#315</strong> 兩數交換（VPL）</li><li style='margin-bottom:3px;'><strong>#316</strong> 選擇結構（測驗）</li><li style='margin-bottom:3px;'><strong>#317</strong> 自動加 1 元（VPL）</li><li style='margin-bottom:3px;'><strong>#318</strong> 計算最高銷量（VPL）</li><li style='margin-bottom:3px;'><strong>#319</strong> 購物折扣計算（VPL）</li></ul><div style='font-size:.72rem;color:#64748b;margin-top:6px;'>課程：115芳和高中資訊科技Py ｜ VPL 題送出後系統會自動「評估」給分</div></div>\n<div style='background:#fffbeb;border-radius:10px;padding:14px;'><strong style='color:#92400e;font-size:.9rem;'>📏 評分規準</strong><p style='font-size:.78rem;color:#334155;margin-top:6px;line-height:1.8;'><strong style='color:#059669;'>A</strong> 全部正確，並用邊界值測試過（截圖或註解說明測了哪些值）<br><strong style='color:#2563eb;'>B</strong> 全部能執行且結果正確<br><strong style='color:#d97706;'>C</strong> 大部分完成，少數條件判斷有誤<br><strong style='color:#dc2626;'>D</strong> 完成一半以下</p></div>", "quiz": null, "chart": null, "video": null}, {"id": 20, "title": "本週總結", "chapter": "實作與總結", "bg": "navy", "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 本週重點</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>循序結構</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>由上往下執行；兩數交換要用暫存變數</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>if / else</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>條件後加冒號、區塊要縮排</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>elif</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>第一個成立就執行，其餘跳過；注意順序</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>測試</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>一定要試邊界值，抓出邏輯錯誤</p></div></div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>「電腦永遠照你寫的做，不是照你想的做。」</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一章：for 與 while 迴圈——讓程式不怕重複</p>\n</div>\n", "quiz": null, "chart": null, "video": null}]