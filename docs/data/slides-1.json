[{"id": 1, "title": "Hello Python!", "chapter": "封面", "bg": "navy", "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>🐍</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>Hello Python!</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Programming Concepts · Google Colab · Input &amp; Output</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>💡 什麼是程式</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>📓 Google Colab</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🖨️ print()</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>⌨️ input()</span></div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>城市科技 · 高一第二學期 ｜ 第 1 週</p>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 2, "title": "這學期要做什麼", "chapter": "第一節：程式與程式語言", "bg": "white", "html": "<h2 class='slide-title'>🗺️ 這學期的地圖：從 Hello 到資料專題</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:18%;'>階段</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:9%;'>週次</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:8%;'>章</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:35%;'>學什麼</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>做出什麼</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🌱 語法與語意</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1–5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1–5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>輸出入、變數、運算子、選擇、迴圈</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>計算機、BMI、九九乘法表</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🧱 陣列資料結構</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6–8</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>串列、二維串列</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>成績單</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🔎 演算法</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>9–11</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>7–8</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>排序、搜尋、函式、遞迴</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>商品搜尋、自己的工具函式</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🤖 資料與 AI</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>12</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>9</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Pandas、機器學習入門</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>開放資料分析、第一個 AI 模型</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🎯 期末專題</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>13–15</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>10</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>API、Gradio 互動網頁</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>與人互動的資料小工具</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🎯 3 學期制的第 2 學期，共 15 週、每週 2 節。期末要做出一個<strong>能和人互動、用真實資料</strong>的小工具，例如「輸入測站，回報空氣品質」。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 3, "title": "什麼是程式設計", "chapter": "第一節：程式與程式語言", "bg": "white", "html": "<h2 class='slide-title'>💡 程式設計 Programming 是什麼？</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>程式（Program）是一組<strong>讓電腦一步一步執行的指令</strong>。程式設計就是把「解決問題的方法」寫成電腦看得懂的指令。</p></div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🔍</div><strong style='color:#1e40af;font-size:.9rem;'>① 分析問題</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>輸入是什麼？要輸出什麼？</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🧭</div><strong style='color:#166534;font-size:.9rem;'>② 設計演算法</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>用步驟、流程圖把方法想清楚</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🛠️</div><strong style='color:#854d0e;font-size:.9rem;'>③ 寫程式＆測試</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>用程式語言實作，再除錯</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🍳 比喻：演算法是<strong>食譜</strong>，程式是用某種語言（中文、英文…）寫下的食譜，電腦是照著做的<strong>廚師</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 4, "title": "程式語言的演進", "chapter": "第一節：程式與程式語言", "bg": "white", "html": "<h2 class='slide-title'>🕰️ 程式語言的演進</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>世代</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>例子</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:50%;'>特色</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>機器語言</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>10110000 01100001</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>只有 0 與 1，電腦直接執行，人很難讀</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>組合語言</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>MOV AL, 61h</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>用英文縮寫代替 0/1，仍和硬體綁在一起</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>高階語言</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>C、Java、<strong>Python</strong></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>接近人類語言，需要編譯器或直譯器翻譯</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>AI 協作時代</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>自然語言提示＋程式</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>AI 幫忙寫、解釋程式，但人仍要<strong>看得懂、驗得了</strong></td></tr></table>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🧠 AI 會寫程式，不代表不用學：看不懂程式的人，就沒辦法判斷 AI 給的答案對不對。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 5, "title": "為什麼學 Python", "chapter": "第一節：程式與程式語言", "bg": "white", "html": "<h2 class='slide-title'>🐍 為什麼選 Python？</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>✨</div><strong style='color:#166534;font-size:.9rem;'>語法簡潔</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>用縮排表示區塊，讀起來接近英文。<br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>print(&quot;Hello&quot;)</code> 一行就能輸出</div></div><div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📦</div><strong style='color:#1e40af;font-size:.9rem;'>套件豐富</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>資料分析（Pandas）、AI（scikit-learn、PyTorch）、網頁、物聯網都能用</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🌏</div><strong style='color:#5b21b6;font-size:.9rem;'>應用廣泛</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>資料科學、機器學習、自動化、教學；也是 APCS 可選用的語言之一</div></div><div style='background:#fff7ed;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>☁️</div><strong style='color:#9a3412;font-size:.9rem;'>免安裝就能寫</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>用瀏覽器開 Google Colab 就能寫，程式在雲端執行</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🇹🇼 在地應用：政府開放資料平臺上的 YouBike、空氣品質、公車動態，都能用 Python 抓下來分析——第 9、10 章就會做。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 6, "title": "第一節 隨堂測驗", "chapter": "第一節：程式與程式語言", "bg": "purple", "quiz": "q1", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>程式與程式語言 ｜ 4 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 7, "title": "認識 Google Colab", "chapter": "第二節：Colab 開發環境", "bg": "white", "html": "<h2 class='slide-title'>📓 Google Colab：雲端的 Python 筆記本</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>Colab（Colaboratory）是 Google 提供的免費線上 Jupyter 筆記本，<strong>不用安裝</strong>，用學校 Google 帳號登入就能寫 Python。</p></div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>☁️</div><strong style='color:#1e40af;font-size:.9rem;'>雲端執行</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>程式在 Google 的主機上跑，學校電腦、家裡電腦、平板都能用</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>💾</div><strong style='color:#166534;font-size:.9rem;'>自動存雲端硬碟</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>筆記本存在你的 Google 雲端硬碟「Colab Notebooks」資料夾</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🔗</div><strong style='color:#854d0e;font-size:.9rem;'>可分享</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>像 Google 文件一樣，用連結分享給老師或組員</div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> ⏱️ 一段時間沒操作，Colab 會中斷連線，變數會清空；重新連線後要從上面的儲存格<strong>再執行一次</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 8, "title": "兩種儲存格", "chapter": "第二節：Colab 開發環境", "bg": "white", "html": "<h2 class='slide-title'>🧱 兩種儲存格：程式碼與文字</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;'><strong style='color:#1e40af;font-size:.9rem;'>💻 程式碼儲存格</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>寫 Python 程式<br>▶ 按左邊播放鍵，或 <strong>Shift + Enter</strong> 執行<br>結果會顯示在下方</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><strong style='color:#166534;font-size:.9rem;'>📝 文字儲存格</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>寫說明、筆記、題目<br>支援 Markdown：<code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'># 標題</code>、<code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>**粗體**</code><br>也能寫數學式：<code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>$x^2$</code></div></div></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:35%;'>快捷鍵</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:65%;'>功能</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Shift + Enter</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>執行目前儲存格並跳到下一格</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Ctrl + Enter</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>執行但停在原儲存格</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Ctrl + /</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>把選取的程式行加上／取消 # 註解</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Ctrl + M  B</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>在下方新增程式碼儲存格</td></tr></table>\n", "quiz": null, "chart": null, "video": null}, {"id": 9, "title": "建議設定", "chapter": "第二節：Colab 開發環境", "bg": "white", "html": "<h2 class='slide-title'>⚙️ 上課前先做的兩個設定</h2>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#1e40af;font-size:.88rem;'>關掉自動完成</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>工具 → 設定 → 編輯器 → <strong>取消</strong>勾選「自動觸發程式碼完成功能」。初學時自己打字，語法才記得住。</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#1e40af;font-size:.88rem;'>儲存副本</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>開啟老師的練習檔後，先按 <strong>檔案 → 在雲端硬碟中儲存副本</strong>，再在副本上作答。否則關掉頁面就不見了。</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#1e40af;font-size:.88rem;'>改檔名</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>副本檔名改成「座號_姓名_py01」，繳交時老師才找得到。</div></div></div></div>\n<div style='background:#fef2f2;padding:11px 16px;border-radius:8px;border-left:4px solid #dc2626;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🤖 Colab 內建 AI 助手（Gemini）。這學期的練習請<strong>先自己寫</strong>，卡住超過 10 分鐘再問 AI，而且要能解釋 AI 給的每一行。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 10, "title": "打開第 1 課練習", "chapter": "第二節：Colab 開發環境", "bg": "white", "html": "<h2 class='slide-title'>📓 打開第 1 課 Colab 練習</h2>\n<div style='display:flex;align-items:center;gap:14px;background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:12px 16px;margin-bottom:12px;'><div style='font-size:2rem;'>📓</div><div style='flex:1;'><strong style='color:#9a3412;font-size:.9rem;'>第 1 課：認識 Colab 與輸出入</strong><div style='font-size:.78rem;color:#475569;margin-top:4px;line-height:1.6;'>包含 print()、input()、註解的示範，以及 3 題實作。記得先「在雲端硬碟中儲存副本」！</div></div><a href='https://colab.research.google.com/github/fhehshs/city-tech-115-2/blob/main/notebooks/py01_hello_colab.ipynb' target='_blank' rel='noopener' style='background:#f9ab00;color:#1f2937;font-weight:700;font-size:.82rem;padding:9px 16px;border-radius:20px;text-decoration:none;white-space:nowrap;'>在 Colab 開啟 ↗</a></div>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>🧪 示範儲存格</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>已經寫好程式，按 ▶ 執行，觀察結果，再試著改改看</div></div><div style='background:#fff7ed;padding:14px;border-radius:10px;'><strong style='color:#9a3412;font-size:.9rem;'>✏️ 練習儲存格</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>開頭寫著「# ✏️ 練習」，只有提示，要自己完成</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 💬 遇到紅字錯誤訊息不要怕！先看<strong>最後一行</strong>：它會告訴你錯誤種類（如 SyntaxError、NameError）和出錯的行號。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 11, "title": "第二節 隨堂測驗", "chapter": "第二節：Colab 開發環境", "bg": "purple", "quiz": "q2", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>Colab 開發環境 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 12, "title": "print() 基本用法", "chapter": "第三節：print 與 input", "bg": "white", "html": "<h2 class='slide-title'>🖨️ print()：讓電腦說話</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>語法：<code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>print(資料1, 資料2, ..., sep=&#x27; &#x27;, end=&#x27;\\n&#x27;)</code>　多個資料用逗號隔開；預設以<strong>空格</strong>分隔、輸出完<strong>換行</strong>。</p></div>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>字串要加引號，數字和運算式不用</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>print(&quot;Hello&quot;, &quot;Python&quot;)\nprint(1 + 2)\nprint(&quot;1+2=&quot;, 1 + 2)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>Hello Python\n3\n1+2= 3</pre></div></div>\n<div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>💡</div><strong style='color:#1e40af;font-size:.9rem;'>引號很重要</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>print(&quot;1+2&quot;)</code> 輸出 <strong>1+2</strong>（字串原樣輸出）<br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>print(1+2)</code> 輸出 <strong>3</strong>（先計算）<br><br>單引號 ' 或雙引號 \" 都可以，但前後要一致。</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 13, "title": "字串串接與重複", "chapter": "第三節：print 與 input", "bg": "white", "html": "<h2 class='slide-title'>➕ 字串可以「加」也可以「乘」</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>print(&quot;Hello&quot; + &quot;Python!&quot;)\nprint(&quot;Go! &quot; * 3)\nprint(&quot;2026&quot;, &quot;11&quot;, &quot;04&quot;, sep=&quot;/&quot;)\nprint(&quot;不換行&quot;, end=&quot;&quot;)\nprint(&quot;…接在後面&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>HelloPython!\nGo! Go! Go! \n2026/11/04\n不換行…接在後面</pre></div></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>寫法</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:70%;'>效果</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>+</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>把兩個字串接起來（中間沒空格）</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>*</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>把字串重複 n 次</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>sep=\"/\"</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>資料之間改用 / 分隔</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>end=\"\"</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>輸出完不換行</td></tr></table>\n</div>\n<div style='background:#fef2f2;padding:11px 16px;border-radius:8px;border-left:4px solid #dc2626;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> ⚠️ <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>&quot;年齡&quot; + 16</code> 會出錯（TypeError）：字串不能直接和數字相加。用逗號 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>print(&quot;年齡&quot;, 16)</code> 就沒問題。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 14, "title": "input() 取得輸入", "chapter": "第三節：print 與 input", "bg": "white", "html": "<h2 class='slide-title'>⌨️ input()：讓使用者輸入</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>語法：<code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>變數 = input(&quot;提示字串&quot;)</code>　程式會停下來等使用者輸入，按 Enter 後把輸入的內容存進變數。</p></div>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>執行後在下方框框輸入名字，按 Enter</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>name = input(&quot;請輸入您的名字：&quot;)\nprint(&quot;你好，&quot;, name)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>請輸入您的名字：小安\n你好， 小安</pre></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🔑 <strong>input() 拿到的一定是字串</strong>。輸入 16，得到的是 \"16\"。要計算的話，下週會學用 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>int()</code>、<code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>float()</code> 轉成數字。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 15, "title": "註解與 f-string", "chapter": "第三節：print 與 input", "bg": "white", "html": "<h2 class='slide-title'>📝 註解 # 與 f-string</h2>\n<div style='display:grid;grid-template-columns:1fr 1.2fr;gap:12px;'><div style='background:#f8fafc;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>💬</div><strong style='color:#334155;font-size:.9rem;'># 註解</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>從 # 到行尾都不會被執行，用來<strong>說明程式</strong>。<br>好的註解寫「為什麼這樣做」，不是重複程式在做什麼。<br>多行一起加註解：選取後按 Ctrl + /</div></div><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>f-string（Python 3.6 起）</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>city = &quot;台北&quot;\nyear = 2026\n# f-string：字串前加 f，變數放在 { } 裡\nprint(f&quot;{year} 年我在{city}&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>2026 年我在台北</pre></div></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 ✨ f-string 是現在最常見的輸出寫法，之後還可以控制小數位數，例如 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>f&quot;{3.14159:.2f}&quot;</code> → 3.14</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 16, "title": "常見錯誤", "chapter": "第三節：print 與 input", "bg": "white", "html": "<h2 class='slide-title'>🐞 新手最常見的 4 種錯誤</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>錯誤寫法</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:22%;'>錯誤訊息</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:48%;'>原因</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>Print(&quot;Hi&quot;)</code></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>NameError</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Python 大小寫有別，要寫 print</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>print(&quot;Hi)</code></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>SyntaxError</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>引號沒有成對</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>print（&quot;Hi&quot;）</code></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>SyntaxError</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>用了<strong>全形</strong>括號，要切換成半形</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>print(name)</code></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>NameError</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>name 還沒有被指定值（或上面的儲存格沒執行）</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🔍 除錯口訣：<strong>看最後一行 → 找行號 → 檢查拼字、引號、括號、全形半形</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 17, "title": "第三節 隨堂測驗", "chapter": "第三節：print 與 input", "bg": "purple", "quiz": "q3", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>print 與 input ｜ 5 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 18, "title": "本週實作", "chapter": "實作與總結", "bg": "white", "html": "<h2 class='slide-title'>✏️ 本週實作：Colab ＋ 線上練習</h2>\n<div style='display:flex;align-items:center;gap:14px;background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:12px 16px;margin-bottom:12px;'><div style='font-size:2rem;'>📓</div><div style='flex:1;'><strong style='color:#9a3412;font-size:.9rem;'>第 1 課 Colab 練習（3 題）</strong><div style='font-size:.78rem;color:#475569;margin-top:4px;line-height:1.6;'>① 說出你的身高　② 自我介紹機　③ 用 f-string 改寫</div></div><a href='https://colab.research.google.com/github/fhehshs/city-tech-115-2/blob/main/notebooks/py01_hello_colab.ipynb' target='_blank' rel='noopener' style='background:#f9ab00;color:#1f2937;font-weight:700;font-size:.82rem;padding:9px 16px;border-radius:20px;text-decoration:none;white-space:nowrap;'>在 Colab 開啟 ↗</a></div>\n<div style='background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:12px 16px;margin-bottom:12px;'><div style='display:flex;justify-content:space-between;align-items:center;gap:10px;'><strong style='color:#166534;font-size:.9rem;'>💻 線上練習（Online Judge）</strong><a href='http://103.226.213.97/course/view.php?id=2109' target='_blank' rel='noopener' style='background:#16a34a;color:#fff;font-weight:700;font-size:.78rem;padding:7px 14px;border-radius:18px;text-decoration:none;white-space:nowrap;'>前往練習網站 ↗</a></div><ul style='margin:8px 0 0 18px;font-size:.8rem;color:#334155;line-height:1.6;'><li style='margin-bottom:3px;'><strong>#301</strong> 輸出指令（測驗）</li><li style='margin-bottom:3px;'><strong>#302</strong> 讓電腦說哈囉（VPL）</li><li style='margin-bottom:3px;'><strong>#303</strong> 輸入指令（測驗）</li><li style='margin-bottom:3px;'><strong>#304</strong> 讓電腦對您說 Hello（VPL）</li></ul><div style='font-size:.72rem;color:#64748b;margin-top:6px;'>課程：115芳和高中資訊科技Py ｜ VPL 題送出後系統會自動「評估」給分</div></div>\n<div style='background:#fffbeb;border-radius:10px;padding:14px;'><strong style='color:#92400e;font-size:.9rem;'>📏 評分規準</strong><p style='font-size:.78rem;color:#334155;margin-top:6px;line-height:1.8;'><strong style='color:#059669;'>A</strong> 3 題都正確，輸出格式整齊，並加上自己的註解<br><strong style='color:#2563eb;'>B</strong> 3 題都能執行，結果正確<br><strong style='color:#d97706;'>C</strong> 完成 2 題，或有小錯誤<br><strong style='color:#dc2626;'>D</strong> 完成 1 題以下</p></div>", "quiz": null, "chart": null, "video": null}, {"id": 19, "title": "本週總結", "chapter": "實作與總結", "bg": "navy", "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 本週重點</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>程式設計</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>分析問題 → 設計演算法 → 寫程式與測試</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>Colab</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>雲端 Python 筆記本；先「儲存副本」再作答</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>print()</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>逗號隔開多個資料；sep 改分隔、end 改結尾</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>input()</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>取得的一定是字串，要計算需轉型</p></div></div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>「程式不是寫給電腦看的，是寫給人看、順便讓電腦執行的。」</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一章：變數、資料型態與運算子——讓程式真的會「算」</p>\n</div>\n", "quiz": null, "chart": null, "video": null}]