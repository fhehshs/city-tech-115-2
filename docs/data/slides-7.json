[{"id": 1, "title": "排序與搜尋", "chapter": "封面", "bg": "navy", "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>🔎</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>排序與搜尋</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Bubble Sort · Sequential Search · Binary Search</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🫧 氣泡排序</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🚶 循序搜尋</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>✂️ 二分搜尋</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>⏱️ 效率比較</span></div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>城市科技 · 高一第二學期 ｜ 第 9–10 週</p>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 2, "title": "生活中的排序", "chapter": "第一節：氣泡排序", "bg": "white", "html": "<h2 class='slide-title'>📶 排序無所不在</h2>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🏅</div><strong style='color:#1e40af;font-size:.9rem;'>成績排名</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>由高到低</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🛍️</div><strong style='color:#166534;font-size:.9rem;'>購物網站</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>依價格、評價排序</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>📇</div><strong style='color:#854d0e;font-size:.9rem;'>通訊錄</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>依姓名筆畫或注音</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🔍</div><strong style='color:#5b21b6;font-size:.9rem;'>搜尋結果</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>依相關程度排序</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 資料排好序之後，「找東西」會快非常多——這就是本週後半要學的二分搜尋。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 3, "title": "氣泡排序原理", "chapter": "第一節：氣泡排序", "bg": "white", "html": "<h2 class='slide-title'>🫧 氣泡排序（Bubble Sort）原理</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>反覆走訪串列，<strong>兩兩比較相鄰的資料，前面比後面大就交換</strong>。每走完一輪，最大的數就像氣泡一樣「浮」到最後面。</p></div>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdfa;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#0d9488;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#115e59;font-size:.88rem;'>比較 a[0] 和 a[1]</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>前面大就交換</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdfa;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#0d9488;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#115e59;font-size:.88rem;'>比較 a[1] 和 a[2]</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>前面大就交換</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdfa;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#0d9488;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#115e59;font-size:.88rem;'>…一路比到最後</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>第 1 輪結束，最大的數到最後一格</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdfa;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#0d9488;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>4</div><div><strong style='color:#115e59;font-size:.88rem;'>重複下一輪</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>已經排好的最後面不用再比</div></div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 📜 氣泡排序是很早被提出的基本排序法，簡單易懂，但資料多時效率不好，常用來入門。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 4, "title": "第 1 輪過程", "chapter": "第一節：氣泡排序", "bg": "white", "html": "<h2 class='slide-title'>🔬 a = [4, 3, 5, 1, 2] 第 1 輪</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:24%;'>比較</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>結果</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:46%;'>串列</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4 vs 3</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4 > 3，交換</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>[<strong>3, 4</strong>, 5, 1, 2]</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4 vs 5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>不交換</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>[3, <strong>4, 5</strong>, 1, 2]</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>5 vs 1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>5 > 1，交換</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>[3, 4, <strong>1, 5</strong>, 2]</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>5 vs 2</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>5 > 2，交換</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>[3, 4, 1, <strong>2, 5</strong>]</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🫧 第 1 輪結束：最大的 <strong>5</strong> 已經到了最後面，第 2 輪只要比前 4 個。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 5, "title": "每一輪結果", "chapter": "第一節：氣泡排序", "bg": "white", "html": "<h2 class='slide-title'>🔁 每一輪的結果</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>輪次</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:22%;'>比較次數</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:58%;'>這輪結束後</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>開始</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>—</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>[4, 3, 5, 1, 2]</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 1 輪</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>[3, 4, 1, 2, <strong>5</strong>]</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 2 輪</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>[3, 1, 2, <strong>4, 5</strong>]</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 3 輪</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>2</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>[1, 2, <strong>3, 4, 5</strong>]</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 4 輪</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>[<strong>1, 2, 3, 4, 5</strong>]</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧮 n 筆資料：最多 n−1 輪；第 i 輪比較 n−i 次。總比較次數 = (n−1) + (n−2) + … + 1 = <strong>n(n−1)/2</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 6, "title": "氣泡排序程式", "chapter": "第一節：氣泡排序", "bg": "white", "html": "<h2 class='slide-title'>💻 氣泡排序程式</h2>\n<div style='display:grid;grid-template-columns:1.5fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>a = [4, 3, 5, 1, 2]\nn = len(a)\nfor i in range(1, n):          # 第 i 輪\n    for j in range(n - i):     # 比較 n-i 次\n        if a[j] &gt; a[j + 1]:\n            a[j], a[j + 1] = a[j + 1], a[j]\n    print(f&quot;第{i}輪：&quot;, a)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>第1輪： [3, 4, 1, 2, 5]\n第2輪： [3, 1, 2, 4, 5]\n第3輪： [1, 2, 3, 4, 5]\n第4輪： [1, 2, 3, 4, 5]</pre></div></div>\n<div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🧩</div><strong style='color:#1e40af;font-size:.9rem;'>用到前幾週的</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>✔ 雙重迴圈（第 4 章）<br>✔ 兩數交換（第 3 章）<br>✔ 串列索引（第 6 章）<br><br>想改成<strong>由大到小</strong>？只要把 &gt; 改成 &lt;。</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧾 對應線上練習 <strong>#502 排序商品編號</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 7, "title": "提早結束", "chapter": "第一節：氣泡排序", "bg": "white", "html": "<h2 class='slide-title'>⚡ 優化：已經排好就提早結束</h2>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>for i in range(1, n):\n    swapped = False\n    for j in range(n - i):\n        if a[j] &gt; a[j + 1]:\n            a[j], a[j + 1] = a[j + 1], a[j]\n            swapped = True\n    if not swapped:      # 這一輪完全沒交換 → 已經排好\n        break</pre></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 💡 上一頁第 3 輪就排好了，第 4 輪是白做的。加一個「有沒有交換」的旗標（flag），可以省下多餘的比較。實際上 Python 的 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>sorted()</code> 用的是更快的演算法（Timsort）。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 8, "title": "第一節 隨堂測驗", "chapter": "第一節：氣泡排序", "bg": "purple", "quiz": "q1", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>氣泡排序 ｜ 4 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 9, "title": "循序搜尋原理", "chapter": "第二節：循序搜尋", "bg": "white", "html": "<h2 class='slide-title'>🚶 循序搜尋（Sequential Search）</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>從第一個開始，<strong>一個一個比對</strong>是否等於要找的鍵值（key），找到就停。</p></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:14%;'>步驟</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:46%;'>比較</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:40%;'>結果</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[0] = 4 是 1 嗎？</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>不是，繼續</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>2</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[1] = 6 是 1 嗎？</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>不是，繼續</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[2] = 3 是 1 嗎？</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>不是，繼續</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[3] = 8 是 1 嗎？</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>不是，繼續</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[4] = 1 是 1 嗎？</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'><strong>找到了！索引 4</strong></td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 📌 a = [4, 6, 3, 8, 1, 2, 7, 5]，搜尋 key = 1。優點：資料<strong>不用先排序</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 10, "title": "循序搜尋程式", "chapter": "第二節：循序搜尋", "bg": "white", "html": "<h2 class='slide-title'>💻 循序搜尋程式</h2>\n<div style='display:grid;grid-template-columns:1.4fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>a = [3, 8, 2, 9, 1, 6, 5, 4, 7]\nkey = int(input(&quot;搜尋：&quot;))\ni = 0\nwhile i &lt; len(a):\n    if a[i] == key:\n        print(&quot;在索引&quot;, i)\n        break\n    i += 1\nif i == len(a):\n    print(&quot;沒搜尋到資料&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>搜尋：5\n在索引 6</pre></div></div>\n<div style='background:#fefce8;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🤔</div><strong style='color:#854d0e;font-size:.9rem;'>怎麼知道沒找到？</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>如果走完整個串列都沒有 break，<br>i 會一路加到 len(a)。<br><br>所以最後檢查 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>i == len(a)</code> 就知道是「找完了還沒找到」。</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧾 對應線上練習 <strong>#504 循序搜尋商品編號</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 11, "title": "循序搜尋效率", "chapter": "第二節：循序搜尋", "bg": "white", "html": "<h2 class='slide-title'>⏱️ 循序搜尋要比幾次？</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:50%;'>情況</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:50%;'>比較次數（n 筆資料）</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>最好：第一個就是</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1 次</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>最差：最後一個或找不到</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>n 次</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>平均</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>約 n/2 次</td></tr></table>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>👍</div><strong style='color:#166534;font-size:.9rem;'>適合</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>資料量小、資料沒排序、只找一兩次</div></div><div style='background:#fef2f2;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>👎</div><strong style='color:#991b1b;font-size:.9rem;'>不適合</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>資料量很大（例如全臺 2300 多萬人的資料）、要反覆搜尋</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🤔 有沒有更快的方法？如果資料<strong>已經排好序</strong>，就可以用二分搜尋！</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 12, "title": "第二節 隨堂測驗", "chapter": "第二節：循序搜尋", "bg": "purple", "quiz": "q2", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>循序搜尋 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 13, "title": "猜數字遊戲", "chapter": "第三節：二分搜尋與效率", "bg": "white", "html": "<h2 class='slide-title'>🎮 猜數字：1～100，最少幾次一定猜得到？</h2>\n<div style='display:grid;grid-template-columns:1fr 1.4fr;gap:12px;'><div style='background:#fef2f2;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🎲</div><strong style='color:#991b1b;font-size:.9rem;'>亂猜</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>可能要猜很多次，運氣好壞差很多</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>✂️</div><strong style='color:#166534;font-size:.9rem;'>每次猜中間</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>猜 50 → 「太大」→ 只剩 1～49<br>猜 25 → 「太小」→ 只剩 26～49<br>…每次<strong>砍掉一半</strong><br><br>最多 <strong>7 次</strong>一定猜到（2⁷ = 128 ≥ 100）</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 💡 這個「每次猜中間、砍一半」的策略，就是<strong>二分搜尋</strong>。前提是資料要<strong>有順序</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 14, "title": "二分搜尋過程", "chapter": "第三節：二分搜尋與效率", "bg": "white", "html": "<h2 class='slide-title'>✂️ 二分搜尋：找商品編號 131</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>a = [101, 103, 107, 112, 118, 125, 131, 140, 152, 160]（已排序），mid = (left + right) // 2</p></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:10%;'>次數</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:10%;'>left</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:10%;'>right</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:10%;'>mid</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:12%;'>a[mid]</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:48%;'>判斷</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>0</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>9</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>118</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>118 &lt; 131 → 往右，left = 5</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>2</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>9</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>7</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>140</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>140 > 131 → 往左，right = 6</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>125</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>125 &lt; 131 → 往右，left = 6</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>131</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'><strong>找到！索引 6</strong></td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🔍 若 left > right 還沒找到，代表資料不在串列裡。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 15, "title": "二分搜尋程式", "chapter": "第三節：二分搜尋與效率", "bg": "white", "html": "<h2 class='slide-title'>💻 二分搜尋程式</h2>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>a = [101, 103, 107, 112, 118, 125, 131, 140, 152, 160]\nkey = int(input(&quot;商品編號：&quot;))\nleft, right = 0, len(a) - 1\ncount, found = 0, -1\nwhile left &lt;= right:\n    mid = (left + right) // 2\n    count += 1\n    if a[mid] == key:\n        found = mid\n        break\n    elif a[mid] &gt; key:\n        right = mid - 1\n    else:\n        left = mid + 1\nprint(&quot;索引&quot;, found, &quot;比較次數&quot;, count)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>商品編號：131\n索引 6 比較次數 4</pre></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧾 對應線上練習 <strong>#505 二分搜尋演算法</strong>、<strong>#506 二分搜尋比較次數</strong>、<strong>#507 二分搜尋商品編號</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 16, "title": "效率比較", "chapter": "第三節：二分搜尋與效率", "bg": "white", "html": "<h2 class='slide-title'>📈 效率比較：資料越多，差距越大</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:40%;'>資料筆數 n</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>循序搜尋最多</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>二分搜尋最多</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>10</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>10 次</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4 次</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1,000</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1,000 次</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>10 次</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>100 萬</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>100 萬次</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>20 次</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>約 2,300 萬（臺灣人口量級）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>約 2,300 萬次</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>25 次</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 循序搜尋的次數和 n 成正比，寫成 <strong>O(n)</strong>；二分搜尋大約是 log₂n，寫成 <strong>O(log n)</strong>。這就是<strong>演算法效能分析</strong>：比較的是「資料變多時，步驟怎麼增加」。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 17, "title": "排序加搜尋", "chapter": "第三節：二分搜尋與效率", "bg": "white", "html": "<h2 class='slide-title'>🤝 排序 ＋ 搜尋：先花時間整理，之後找得快</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>📚</div><strong style='color:#1e40af;font-size:.9rem;'>圖書館</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>書依索書號排好，才能很快找到</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>📖</div><strong style='color:#166534;font-size:.9rem;'>字典</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>依字母或部首排序，翻一半一半找</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🗃️</div><strong style='color:#854d0e;font-size:.9rem;'>資料庫</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>幫資料建「索引」，查詢才快</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 ⚖️ 取捨：只找一次，循序搜尋就夠；要反覆找很多次，先排序再用二分搜尋比較划算。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 18, "title": "第三節 隨堂測驗", "chapter": "第三節：二分搜尋與效率", "bg": "purple", "quiz": "q3", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>二分搜尋與效率 ｜ 4 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 19, "title": "本週實作", "chapter": "實作與總結", "bg": "white", "html": "<h2 class='slide-title'>✏️ 本週實作：Colab ＋ 線上練習 ＋ APCS 挑戰</h2>\n<div style='display:flex;align-items:center;gap:14px;background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:12px 16px;margin-bottom:12px;'><div style='font-size:2rem;'>📓</div><div style='flex:1;'><strong style='color:#9a3412;font-size:.9rem;'>第 7 課 Colab 練習</strong><div style='font-size:.78rem;color:#475569;margin-top:4px;line-height:1.6;'>氣泡排序（輸出每一輪）、循序搜尋、二分搜尋（含比較次數）、APCS 成績指標<br>🔐 請用學校 Google 帳號登入才能開啟。</div></div><a href='https://colab.research.google.com/drive/1_-D-IdrcjgtcJ8xfuxLnyHzfLPQcchPD' target='_blank' rel='noopener' style='background:#f9ab00;color:#1f2937;font-weight:700;font-size:.82rem;padding:9px 16px;border-radius:20px;text-decoration:none;white-space:nowrap;'>在 Colab 開啟 ↗</a></div>\n<div style='background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:12px 16px;margin-bottom:12px;'><div style='display:flex;justify-content:space-between;align-items:center;gap:10px;'><strong style='color:#166534;font-size:.9rem;'>💻 線上練習（Online Judge）</strong><a href='http://103.226.213.97/course/view.php?id=2109' target='_blank' rel='noopener' style='background:#16a34a;color:#fff;font-weight:700;font-size:.78rem;padding:7px 14px;border-radius:18px;text-decoration:none;white-space:nowrap;'>前往練習網站 ↗</a></div><ul style='margin:8px 0 0 18px;font-size:.8rem;color:#334155;line-height:1.6;'><li style='margin-bottom:3px;'><strong>#501、#503、#505、#506</strong> 氣泡排序、循序搜尋、二分搜尋觀念（測驗）</li><li style='margin-bottom:3px;'><strong>#502</strong> 排序商品編號（VPL）</li><li style='margin-bottom:3px;'><strong>#504</strong> 循序搜尋商品編號（VPL）</li><li style='margin-bottom:3px;'><strong>#507</strong> 二分搜尋商品編號（VPL）</li></ul><div style='font-size:.72rem;color:#64748b;margin-top:6px;'>課程：115芳和高中資訊科技Py ｜ VPL 題送出後系統會自動「評估」給分</div></div>\n<div style='background:#f5f3ff;padding:11px 16px;border-radius:8px;border-left:4px solid #7c3aed;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🎓 選做：APCS 105 年 3 月第 1 題「成績指標」，用排序就能解。題目 PDF 連結在 Colab 裡。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 20, "title": "本週總結", "chapter": "實作與總結", "bg": "navy", "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 本週重點</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>氣泡排序</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>相鄰比較、大的往後交換；n−1 輪</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>循序搜尋</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>一個一個找；不用排序；O(n)</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>二分搜尋</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>每次砍一半；要先排序；O(log n)</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>效能分析</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>比較資料變多時，步驟增加的速度</p></div></div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>「好的演算法，讓 2300 萬筆資料只要找 25 次。」</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一章：函式與遞迴——把程式打包成可重複使用的工具</p>\n</div>\n", "quiz": null, "chart": null, "video": null}]