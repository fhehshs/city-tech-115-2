[{"id": 1, "title": "學習挑戰", "chapter": "封面", "bg": "navy", "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>🏆</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>學習挑戰</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Problem Solving · Online Judge · Challenge Week</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🧭 解題四步驟</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>💻 Online Judge</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🧮 計算題</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🔁 迴圈題</span></div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>城市科技 · 高一第二學期 ｜ 第 5 週</p>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 2, "title": "解題四步驟", "chapter": "第一節：解題方法與 Online Judge", "bg": "white", "html": "<h2 class='slide-title'>🧭 解題四步驟</h2>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#1e40af;font-size:.88rem;'>讀題：找出輸入與輸出</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>輸入有幾個數？用空白還是換行隔開？輸出要什麼格式？</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#1e40af;font-size:.88rem;'>舉例：自己手算 2～3 組</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>用題目的範例，再自己想一組「邊界」的例子</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#1e40af;font-size:.88rem;'>寫程式：先求對，再求好</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>從輸入 → 處理 → 輸出，一段一段寫、一段一段測</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>4</div><div><strong style='color:#1e40af;font-size:.88rem;'>測試：包含特殊情況</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>0、負數、剛好等於條件的值、最大值</div></div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 這就是<strong>運算思維</strong>：拆解問題、找出規律、抽象化、設計演算法。上學期的 Bebras 挑戰賽練的也是這些能力。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 3, "title": "認識 Online Judge", "chapter": "第一節：解題方法與 Online Judge", "bg": "white", "html": "<h2 class='slide-title'>💻 Online Judge：讓系統幫你改程式</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>Online Judge（線上評測系統）會用<strong>好幾組測試資料</strong>執行你的程式，比對輸出是否和標準答案<strong>完全一樣</strong>，自動給分。</p></div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🏫</div><strong style='color:#166534;font-size:.9rem;'>本課程練習網站</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>Moodle VPL<br>115芳和高中資訊科技Py<br>#301～#513</div></div><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>⚖️</div><strong style='color:#1e40af;font-size:.9rem;'>ZeroJudge</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>高中生線上解題系統<br>zerojudge.tw<br>題庫最多、有排名</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🎓</div><strong style='color:#5b21b6;font-size:.9rem;'>APCS</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>大學程式設計先修檢測<br>觀念題＋實作題<br>可作為申請入學參考</div></div></div>\n<div style='background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:12px 16px;margin-bottom:12px;'><div style='display:flex;justify-content:space-between;align-items:center;gap:10px;'><strong style='color:#166534;font-size:.9rem;'>💻 本課程的線上練習網站</strong><a href='http://103.226.213.97/course/view.php?id=2109' target='_blank' rel='noopener' style='background:#16a34a;color:#fff;font-weight:700;font-size:.78rem;padding:7px 14px;border-radius:18px;text-decoration:none;white-space:nowrap;'>前往練習網站 ↗</a></div><ul style='margin:8px 0 0 18px;font-size:.8rem;color:#334155;line-height:1.6;'><li style='margin-bottom:3px;'><strong>使用方式</strong> 登入 → 點題目 → 編輯程式 → 「評估」看分數</li><li style='margin-bottom:3px;'><strong>注意</strong> 「評估」沒有滿分不要緊，看系統提示修正後可以再評估</li></ul><div style='font-size:.72rem;color:#64748b;margin-top:6px;'>課程：115芳和高中資訊科技Py ｜ VPL 題送出後系統會自動「評估」給分</div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 4, "title": "輸出格式要一模一樣", "chapter": "第一節：解題方法與 Online Judge", "bg": "white", "html": "<h2 class='slide-title'>🎯 輸出要「一字不差」</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>題目要求</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:40%;'>你的輸出</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>結果</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>15</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>答案是 15</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>❌ 多了文字</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>15</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>15（後面多一個空格）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>⚠️ 有些系統會判錯</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>大吉</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>大 吉</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>❌ 多了空白</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3.50</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3.5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>❌ 小數位數不對</td></tr></table>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;'><div style='background:#fef2f2;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🚫</div><strong style='color:#991b1b;font-size:.9rem;'>線上練習時</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>input()</code> 括號內<strong>不要寫提示字</strong>，<br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>print()</code> 只印題目要求的內容。</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🔢</div><strong style='color:#166534;font-size:.9rem;'>小數位數</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>print(f&quot;{x:.2f}&quot;)</code> → 固定 2 位小數<br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>round(x, 2)</code> → 四捨五入到 2 位（但 3.50 會變 3.5）</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 5, "title": "讀懂題目格式", "chapter": "第一節：解題方法與 Online Judge", "bg": "white", "html": "<h2 class='slide-title'>📄 讀懂題目格式</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:32%;'>題目寫法</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:24%;'>代表</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:44%;'>Python 讀法</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>一行一個整數 N</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>只輸入一個數</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>n = int(input())</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>一行兩個整數，以空白隔開</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>同一行兩個數</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a, b = map(int, input().split())</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第一行 n，第二行 n 個整數</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>先給個數，再給一串</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>n = int(input())<br>a = list(map(int, input().split()))</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>輸入有多行，每行一筆</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>要讀很多次</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>用 for 迴圈讀 n 次 input()</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 📌 第三種寫法會得到一個<strong>串列</strong>，第 6 章會詳細學。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 6, "title": "錯誤訊息看懂", "chapter": "第一節：解題方法與 Online Judge", "bg": "white", "html": "<h2 class='slide-title'>🧯 評測結果看不懂？</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>狀況</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:26%;'>意思</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:44%;'>常見原因</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>輸出不符（Wrong Answer）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>程式能跑，答案錯</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>邏輯錯、格式多空白、多了提示字</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>執行錯誤（Runtime Error）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>執行到一半當掉</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>輸入讀錯（ValueError）、除以 0、索引超出範圍</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>逾時（Time Limit）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>跑太久</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>無窮迴圈、演算法太慢</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>編譯／語法錯誤</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>程式本身寫錯</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>少冒號、縮排錯、全形符號</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 💡 先在 Colab 用題目的範例測過、結果完全一樣，再貼到線上練習網站評估。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 7, "title": "第一節 隨堂測驗", "chapter": "第一節：解題方法與 Online Judge", "bg": "purple", "quiz": "q1", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>解題方法與 Online Judge ｜ 4 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 8, "title": "梯形面積", "chapter": "第二節：計算型題目", "bg": "white", "html": "<h2 class='slide-title'>📐 計算題 1：梯形面積</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>輸入上底、下底、高</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>a = int(input())\nb = int(input())\nh = int(input())\nprint((a + b) * h / 2)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>3\n5\n4\n16.0</pre></div></div>\n<div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🤔</div><strong style='color:#1e40af;font-size:.9rem;'>想一想</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>為什麼輸出是 16.0 而不是 16？<br><br>因為 / 的結果一定是 float。如果題目要整數，可以改用 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>(a + b) * h // 2</code>，但要小心奇數會被捨去。</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 9, "title": "三角形與海龍公式", "chapter": "第二節：計算型題目", "bg": "white", "html": "<h2 class='slide-title'>🔺 計算題 2：三角形周長與面積</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>海龍公式：s = (a + b + c) / 2，面積 = √(s(s−a)(s−b)(s−c))。Python 開根號：<code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>x ** 0.5</code></p></div>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>a = int(input())\nb = int(input())\nc = int(input())\nif a + b &gt; c and a + c &gt; b and b + c &gt; a:\n    s = (a + b + c) / 2\n    area = (s * (s - a) * (s - b) * (s - c)) ** 0.5\n    print(&quot;周長 =&quot;, a + b + c)\n    print(&quot;面積 =&quot;, round(area, 2))\nelse:\n    print(&quot;無法構成三角形&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>3\n4\n5\n周長 = 12\n面積 = 6.0</pre></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧩 計算前先<strong>檢查輸入是否合理</strong>——這個習慣在處理真實資料（第 9、10 章）時非常重要。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 10, "title": "滿千折百", "chapter": "第二節：計算型題目", "bg": "white", "html": "<h2 class='slide-title'>🛒 計算題 3：百貨週年慶滿千折百</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>m = int(input())\nk = m // 1000          # 滿了幾個 1000\nprint(m - k * 100)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>2350\n2150</pre></div></div>\n<div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>💡</div><strong style='color:#166534;font-size:.9rem;'>不用 if 也能做</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>用 // 算出「滿幾個 1000」，乘以 100 就是折抵金額。<br><br>很多題目用 // 和 % 就能處理，不一定要用判斷。</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧾 對應線上練習 <strong>#310 計算滿千折百後應付金額</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 11, "title": "Sagit 計分程式", "chapter": "第二節：計算型題目", "bg": "white", "html": "<h2 class='slide-title'>🧮 計算題 4：Sagit's 計分程式（ZeroJudge a053）</h2>\n<div style='display:grid;grid-template-columns:1fr 1.1fr;gap:12px;'><table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:35%;'>答對題數</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:65%;'>計分方式</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>0～10</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>每題 6 分</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>11～20</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>前 10 題 60 分，之後每題 2 分</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>21～40</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>前 20 題 80 分，之後每題 1 分</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>40 以上</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>一律 100 分</td></tr></table>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>n = int(input())\nif n &lt;= 10:\n    s = n * 6\nelif n &lt;= 20:\n    s = 60 + (n - 10) * 2\nelif n &lt;= 40:\n    s = 80 + (n - 20)\nelse:\n    s = 100\nprint(s)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>25\n85</pre></div></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🔗 題目原文：zerojudge.tw 題號 a053。<strong>分段計分</strong>和電費、計程車資的算法一樣。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 12, "title": "第二節 隨堂測驗", "chapter": "第二節：計算型題目", "bg": "purple", "quiz": "q2", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>計算型題目 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 13, "title": "兩光法師占卜", "chapter": "第三節：判斷與迴圈型題目", "bg": "white", "html": "<h2 class='slide-title'>🔮 判斷題：兩光法師占卜術（ZeroJudge a003）</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>m, d = map(int, input().split())\ns = (m * 2 + d) % 3\nif s == 0:\n    print(&quot;普通&quot;)\nelif s == 1:\n    print(&quot;吉&quot;)\nelse:\n    print(&quot;大吉&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>1 1\n普通</pre></div></div>\n<div style='background:#f5f3ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📜</div><strong style='color:#5b21b6;font-size:.9rem;'>規則</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>S = (M × 2 + D) % 3<br>S = 0 → 普通<br>S = 1 → 吉<br>S = 2 → 大吉<br><br>% 3 的結果只可能是 0、1、2，所以 else 就是 2。</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 14, "title": "糖果分裝", "chapter": "第三節：判斷與迴圈型題目", "bg": "white", "html": "<h2 class='slide-title'>🍬 迴圈題 1：糖果分裝</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>最多 3000 個糖果，7 個一數餘 5、11 個一數餘 5、17 個一數餘 5，可能有幾個糖果？</p></div>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>暴力法：一個一個試</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>for i in range(1, 3001):\n    if i % 7 == 5 and i % 11 == 5 and i % 17 == 5:\n        print(i)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>5\n1314\n2623</pre></div></div>\n<div style='background:#fefce8;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🔢</div><strong style='color:#854d0e;font-size:.9rem;'>數學觀點</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>7、11、17 的最小公倍數是 1309，所以答案是 5、5 + 1309、5 + 2 × 1309。<br><br>電腦很會「一個一個試」，這叫<strong>窮舉法（暴力法）</strong>。</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 15, "title": "盈數虧數完全數", "chapter": "第三節：判斷與迴圈型題目", "bg": "white", "html": "<h2 class='slide-title'>🔍 迴圈題 2：盈數、虧數和完全數（ZeroJudge d010）</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>n = int(input())\ns = 0\nfor i in range(1, n):\n    if n % i == 0:     # i 是 n 的因數\n        s += i\nif s &gt; n:\n    print(&quot;盈數&quot;)\nelif s &lt; n:\n    print(&quot;虧數&quot;)\nelse:\n    print(&quot;完全數&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>28\n完全數</pre></div></div>\n<div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🧩</div><strong style='color:#166534;font-size:.9rem;'>迴圈＋判斷＋累加</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>用迴圈把 1 到 n−1 都試一次，<br>能整除的就是因數，累加起來，<br>最後再判斷大小。<br><br>6、28、496 都是完全數。</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 16, "title": "儲蓄計畫", "chapter": "第三節：判斷與迴圈型題目", "bg": "white", "html": "<h2 class='slide-title'>💰 迴圈題 3：儲蓄計畫</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>第 1 個月存 100 元，之後每月比前月多 10%（去除小數），存到累計超過 1000 元為止。</p></div>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>m = 100\ntotal = 100\ni = 1\nprint(f&quot;第{i}個月存{m}元，共{total}元&quot;)\nwhile total &lt;= 1000:\n    m = int(m * 1.1)\n    total += m\n    i += 1\n    print(f&quot;第{i}個月存{m}元，共{total}元&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>第1個月存100元，共100元\n第2個月存110元，共210元\n…\n第7個月存176元，共946元\n第8個月存193元，共1139元</pre></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🏦 這就是<strong>複利</strong>的概念；銀行存款、通膨、人口成長都可以用類似的迴圈模擬。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 17, "title": "印出長方形", "chapter": "第三節：判斷與迴圈型題目", "bg": "white", "html": "<h2 class='slide-title'>🧱 迴圈題 4：印出長方形</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>雙重迴圈寫法</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>x, y = map(int, input().split())\nfor i in range(x):\n    for j in range(y):\n        print(&quot;*&quot;, end=&quot;&quot;)\n    print()</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>3 5\n*****\n*****\n*****</pre></div></div>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>Python 字串重複寫法</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>x, y = map(int, input().split())\nfor i in range(x):\n    print(&quot;*&quot; * y)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>3 5\n*****\n*****\n*****</pre></div></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🤔 兩種寫法結果相同。考試或線上練習，選你<strong>最有把握不出錯</strong>的寫法。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 18, "title": "第三節 隨堂測驗", "chapter": "第三節：判斷與迴圈型題目", "bg": "purple", "quiz": "q3", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>判斷與迴圈型題目 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 19, "title": "挑戰賽規則", "chapter": "挑戰賽與總結", "bg": "white", "html": "<h2 class='slide-title'>🏁 課堂挑戰賽：出題、說題、解題、教題</h2>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🎲</div><strong style='color:#1e40af;font-size:.9rem;'>① 出題</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>各組抽一題（Colab 第 5 課的 9 題）</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🗺️</div><strong style='color:#166534;font-size:.9rem;'>② 說題</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>用流程圖說明解法，不急著寫程式</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>💻</div><strong style='color:#854d0e;font-size:.9rem;'>③ 解題</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>寫出程式，用範例和邊界值測試</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🎤</div><strong style='color:#5b21b6;font-size:.9rem;'>④ 教題</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>上台 3 分鐘，教會全班</div></div></div>\n<div style='display:flex;align-items:center;gap:14px;background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:12px 16px;margin-bottom:12px;'><div style='font-size:2rem;'>📓</div><div style='flex:1;'><strong style='color:#9a3412;font-size:.9rem;'>第 5 課 Colab：學習挑戰 9 題</strong><div style='font-size:.78rem;color:#475569;margin-top:4px;line-height:1.6;'>梯形、絕對值、三角形、糖果、儲蓄、a053 計分、a003 占卜、d010 盈虧數、長方形<br>🔐 請用學校 Google 帳號登入才能開啟。</div></div><a href='https://colab.research.google.com/drive/1qdbzxfci6JCBbU3RkJHI9WvpBuzl-Xub' target='_blank' rel='noopener' style='background:#f9ab00;color:#1f2937;font-weight:700;font-size:.82rem;padding:9px 16px;border-radius:20px;text-decoration:none;white-space:nowrap;'>在 Colab 開啟 ↗</a></div>\n<div style='background:#fffbeb;border-radius:10px;padding:14px;'><strong style='color:#92400e;font-size:.9rem;'>📏 評分規準</strong><p style='font-size:.78rem;color:#334155;margin-top:6px;line-height:1.8;'><strong style='color:#059669;'>A</strong> 程式正確且有測邊界值；說明清楚，同學能聽懂並照著做出來<br><strong style='color:#2563eb;'>B</strong> 程式正確，說明大致清楚<br><strong style='color:#d97706;'>C</strong> 程式部分正確，或說明不夠清楚<br><strong style='color:#dc2626;'>D</strong> 未完成或無法說明</p></div>", "quiz": null, "chart": null, "video": null}, {"id": 20, "title": "本週總結", "chapter": "挑戰賽與總結", "bg": "navy", "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 本週重點</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>解題四步驟</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>讀題 → 舉例 → 寫程式 → 測試</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>Online Judge</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>輸出要一字不差，input() 不寫提示字</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>常用技巧</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>// 與 % 拆數字、分段計分、窮舉法</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>前 5 週</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>輸出入＋運算＋選擇＋重複 = 能解很多題目了！</p></div></div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>「會教別人的時候，才是真的學會了。」</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一章：串列與二維串列——一次處理一整班的成績</p>\n</div>\n", "quiz": null, "chart": null, "video": null}]