[{"id": 1, "title": "串列與二維串列", "chapter": "封面", "bg": "navy", "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>📚</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>串列 List</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Lists · Index · 2D Lists</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🗄️ 串列</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🔢 索引從 0 開始</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🏆 最大與最小</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>📊 二維成績單</span></div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>城市科技 · 高一第二學期 ｜ 第 6–8 週</p>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 2, "title": "為什麼需要串列", "chapter": "第一節：認識串列與索引", "bg": "white", "html": "<h2 class='slide-title'>🤯 1000 位學生的成績，要開 1000 個變數？</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>用變數：不可能</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>a1 = 81\na2 = 82\na3 = 83\n# ……a1000 = ??</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'></pre></div></div>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>用串列：一個名字裝全部</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>score = [81, 82, 83, 84, 85]\nprint(score)\nprint(len(score))</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>[81, 82, 83, 84, 85]\n5</pre></div></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🗄️ 串列（list）是 Python 最重要的<strong>資料結構</strong>：用中括號 [ ] 把資料包起來，元素之間用逗號隔開，型態可以不同。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 3, "title": "索引", "chapter": "第一節：認識串列與索引", "bg": "white", "html": "<h2 class='slide-title'>🔢 索引（index）：從 0 開始編號</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>串列像一排置物櫃，每一格都有編號。<strong>第 1 格的編號是 0</strong>，第 i 個元素是 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>a[i-1]</code>。</p></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>元素</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>81</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>82</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>83</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>84</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>85</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>正向索引</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[0]</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[1]</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[2]</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[3]</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[4]</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>反向索引</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[-5]</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[-4]</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[-3]</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[-2]</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a[-1]</td></tr></table>\n<div style='background:#fef2f2;padding:11px 16px;border-radius:8px;border-left:4px solid #dc2626;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> ⚠️ <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>a[5]</code> 超出範圍，會出現 <strong>IndexError: list index out of range</strong>。這是使用串列最常見的錯誤。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 4, "title": "小試身手", "chapter": "第一節：認識串列與索引", "bg": "white", "html": "<h2 class='slide-title'>🧪 小試身手：先猜再看</h2>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>b = [1, 2, 3, 4, 5, 6]\nprint(b[0], b[5], b[-1], b[-6])\nprint(b[6])</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>1 6 6 1\nIndexError: list index out of range</pre></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 串列長度是 n，正向索引是 <strong>0 ～ n−1</strong>，反向索引是 <strong>−1 ～ −n</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 5, "title": "在地例子", "chapter": "第一節：認識串列與索引", "bg": "white", "html": "<h2 class='slide-title'>🚇 生活中的「串列」</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🚇</div><strong style='color:#1e40af;font-size:.9rem;'>捷運文湖線</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>[\"動物園\", \"木柵\", \"萬芳社區\", \"萬芳醫院\", \"辛亥\", …]<br>站的順序就是索引</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🌫️</div><strong style='color:#166534;font-size:.9rem;'>一週 AQI</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>[52, 61, 48, 95, 110, 73, 66]<br>索引 0 是星期一</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🛒</div><strong style='color:#854d0e;font-size:.9rem;'>購物車</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>[\"筆記本\", \"原子筆\", \"便當\"]<br>可以加入、刪除、修改</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 📌 只要是「<strong>一串同類的資料，而且有順序</strong>」，就適合用串列。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 6, "title": "第一節 隨堂測驗", "chapter": "第一節：認識串列與索引", "bg": "purple", "quiz": "q1", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>串列與索引 ｜ 4 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 7, "title": "走訪串列", "chapter": "第二節：串列操作", "bg": "white", "html": "<h2 class='slide-title'>🚶 走訪串列：兩種 for 寫法</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>直接取元素（只需要值時）</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>n = [10, 20, 30, 40]\nfor x in n:\n    print(x, end=&quot; &quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>10 20 30 40 </pre></div></div>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>用索引取（需要位置時）</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>n = [10, 20, 30, 40]\nfor i in range(len(n)):\n    print(i, n[i])</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>0 10\n1 20\n2 30\n3 40</pre></div></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 💡 要「改」元素、或要知道「第幾個」時，用索引寫法。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 8, "title": "成員、串接、重複", "chapter": "第二節：串列操作", "bg": "white", "html": "<h2 class='slide-title'>🔍 in、+、* </h2>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>fruits = [&quot;蘋果&quot;, &quot;橘子&quot;, &quot;香蕉&quot;]\nprint(&quot;蘋果&quot; in fruits)\nprint(&quot;西瓜&quot; not in fruits)\nprint(fruits + [&quot;芒果&quot;])\nprint([0] * 4)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>True\nTrue\n[&#x27;蘋果&#x27;, &#x27;橘子&#x27;, &#x27;香蕉&#x27;, &#x27;芒果&#x27;]\n[0, 0, 0, 0]</pre></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧰 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>[0] * 4</code> 很常用來建立「一開始全部是 0」的計數串列，例如統計每個等第有幾人。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 9, "title": "切片", "chapter": "第二節：串列操作", "bg": "white", "html": "<h2 class='slide-title'>✂️ 切片 slice：a[開始:結束]</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>a = [81, 82, 83, 84, 85]\nprint(a[1:3])\nprint(a[:4])\nprint(a[3:])\nprint(a[::-1])</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>[82, 83]\n[81, 82, 83, 84]\n[84, 85]\n[85, 84, 83, 82, 81]</pre></div></div>\n<div style='background:#f5f3ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📐</div><strong style='color:#5b21b6;font-size:.9rem;'>和 range 一樣</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>「結束」不包含。<br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>a[1:3]</code> 是索引 1、2<br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>a[:4]</code> 從頭到索引 3<br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>a[3:]</code> 索引 3 到最後<br><code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>a[::-1]</code> 反轉</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 10, "title": "修改與新增刪除", "chapter": "第二節：串列操作", "bg": "white", "html": "<h2 class='slide-title'>🛠️ 修改、新增、刪除</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>cart = [&quot;筆記本&quot;, &quot;原子筆&quot;]\ncart.append(&quot;便當&quot;)     # 加在最後\ncart[0] = &quot;活頁紙&quot;       # 修改\ncart.remove(&quot;原子筆&quot;)    # 刪除指定元素\nprint(cart, len(cart))</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>[&#x27;活頁紙&#x27;, &#x27;便當&#x27;] 2</pre></div></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:45%;'>寫法</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:55%;'>作用</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a.append(x)</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>在最後加入 x</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a.insert(i, x)</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>在索引 i 插入 x</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a.remove(x)</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>刪除第一個 x</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a.pop()</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>取出並刪除最後一個</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a.sort()</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>由小到大排序</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>a.index(x)</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>找 x 的索引</td></tr></table>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 11, "title": "第二節 隨堂測驗", "chapter": "第二節：串列操作", "bg": "purple", "quiz": "q2", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>串列操作 ｜ 4 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 12, "title": "找最高分", "chapter": "第三節：最大、最小、總和", "bg": "white", "html": "<h2 class='slide-title'>🏆 找最高分：打擂台法再登場</h2>\n<div style='display:grid;grid-template-columns:1.3fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>score = [88, 51, 84, 58, 91, 86, 75, 92, 66, 82]\nmx = score[0]\nfor s in score:\n    if s &gt; mx:\n        mx = s\nprint(&quot;最高分&quot;, mx)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>最高分 92</pre></div></div>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#fefce8;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#f59e0b;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#854d0e;font-size:.88rem;'>先假設第一個最大</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>mx = score[0]</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#fefce8;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#f59e0b;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#854d0e;font-size:.88rem;'>一個一個比</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>比 mx 大就換掉</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#fefce8;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#f59e0b;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#854d0e;font-size:.88rem;'>走完就是答案</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>時間跟資料量成正比</div></div></div></div>\n</div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> ⚠️ 別寫 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>mx = 0</code>：如果成績全是負數（例如溫度），答案就錯了。從第一個元素開始最保險。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 13, "title": "最低分與位置", "chapter": "第三節：最大、最小、總和", "bg": "white", "html": "<h2 class='slide-title'>📉 最低分，順便記住是第幾號</h2>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>要知道位置 → 用索引寫法</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>score = [88, 51, 84, 58, 91, 86, 75, 92, 66, 82]\nmn, pos = score[0], 0\nfor i in range(len(score)):\n    if score[i] &lt; mn:\n        mn, pos = score[i], i\nprint(&quot;最低分&quot;, mn, &quot;是&quot;, pos + 1, &quot;號&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>最低分 51 是 2 號</pre></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧾 對應線上練習 <strong>#403 計算最高銷售量</strong>、<strong>#404 計算最高與最低銷售量</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 14, "title": "總和與平均", "chapter": "第三節：最大、最小、總和", "bg": "white", "html": "<h2 class='slide-title'>➕ 總和與平均</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>自己寫迴圈</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>score = [88, 51, 84, 58, 91, 86, 75, 92, 66, 82]\ntotal = 0\nfor s in score:\n    total += s\nprint(&quot;總分&quot;, total)\nprint(&quot;平均&quot;, total / len(score))</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>總分 773\n平均 77.3</pre></div></div>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><div style='font-size:.72rem;color:#94a3b8;margin-bottom:6px;'>內建函式驗算</div><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>print(max(score), min(score))\nprint(sum(score), sum(score) / len(score))\nprint(sorted(score))</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>92 51\n773 77.3\n[51, 58, 66, 75, 82, 84, 86, 88, 91, 92]</pre></div></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🎯 平常用內建函式很方便；但<strong>考試和線上練習常常要求自己寫</strong>，而且懂原理才能處理變化題（例如「第二高分」）。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 15, "title": "第三節 隨堂測驗", "chapter": "第三節：最大、最小、總和", "bg": "purple", "quiz": "q3", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>最大、最小、總和 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 16, "title": "二維串列", "chapter": "第四節：二維串列", "bg": "white", "html": "<h2 class='slide-title'>📊 二維串列：串列裡放串列</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>5 位同學、3 科成績 → 5 列 × 3 行的表格。<strong>先列後行</strong>：<code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>c[i][j]</code> 是第 i 列、第 j 行（都從 0 開始）。</p></div>\n<div style='display:grid;grid-template-columns:1fr 1.2fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>c = [[85, 90, 78],\n     [72, 65, 80],\n     [95, 88, 92],\n     [60, 75, 70],\n     [88, 94, 85]]\nprint(c[2])\nprint(c[2][1])\nprint(len(c), len(c[0]))</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>[95, 88, 92]\n88\n5 3</pre></div></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;'></th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>國文 j=0</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>英文 j=1</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>數學 j=2</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>i=0</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>85</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>90</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>78</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>i=1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>72</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>65</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>80</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>i=2</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>95</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'><strong>88</strong></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>92</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>i=3</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>60</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>75</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>70</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>i=4</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>88</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>94</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>85</td></tr></table>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 17, "title": "走訪二維串列", "chapter": "第四節：二維串列", "bg": "white", "html": "<h2 class='slide-title'>🔁🔁 用雙重迴圈走訪二維串列</h2>\n<div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>for i in range(len(c)):          # 外圈：每一列（每位同學）\n    for j in range(len(c[i])):   # 內圈：每一行（每一科）\n        print(c[i][j], end=&quot; &quot;)\n    print()</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>85 90 78\n72 65 80\n95 88 92\n60 75 70\n88 94 85</pre></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🔗 和上週的「雙重迴圈印星號」是同一個結構，只是把 * 換成 <code style='background:#e2e8f0;color:#0f172a;padding:1px 6px;border-radius:4px;font-family:Consolas,Menlo,monospace;font-size:.85em;'>c[i][j]</code>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 18, "title": "成績單", "chapter": "第四節：二維串列", "bg": "white", "html": "<h2 class='slide-title'>🧾 範例：成績單——每人總分與平均</h2>\n<div style='display:grid;grid-template-columns:1.5fr 1fr;gap:12px;'><div style='background:#1e293b;border-radius:10px;overflow:hidden;margin-bottom:12px;'><div style='padding:10px 14px;'><pre style='margin:0;color:#e2e8f0;font-size:.82rem;line-height:1.6;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>for i in range(len(c)):\n    t = 0                     # 每位同學重新歸零\n    for j in range(len(c[i])):\n        t += c[i][j]\n    print(f&quot;{i+1}號 總分 {t} 平均 {t/len(c[i]):.1f}&quot;)</pre></div><div style='background:#0b1220;border-top:1px dashed #334155;padding:8px 14px;'><span style='font-size:.68rem;color:#64748b;'>▶ 執行結果</span><pre style='margin:4px 0 0;color:#a7f3d0;font-size:.8rem;line-height:1.55;white-space:pre-wrap;font-family:Consolas,Menlo,monospace;'>1號 總分 253 平均 84.3\n2號 總分 217 平均 72.3\n3號 總分 275 平均 91.7\n4號 總分 205 平均 68.3\n5號 總分 267 平均 89.0</pre></div></div>\n<div style='background:#fff7ed;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📍</div><strong style='color:#9a3412;font-size:.9rem;'>關鍵：t = 0 放哪裡？</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>放在<strong>外圈裡、內圈前</strong>：每換一位同學就重新累加。<br><br>放在最外面 → 總分會一直累積到下一個人。</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧾 對應線上練習 <strong>#408 計算銷售總和</strong>。挑戰：改成計算「每一科」的平均（外圈換成 j）。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 19, "title": "二維串列的應用", "chapter": "第四節：二維串列", "bg": "white", "html": "<h2 class='slide-title'>🗺️ 二維串列在哪裡？</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>📊</div><strong style='color:#1e40af;font-size:.9rem;'>試算表</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>Google 試算表、Excel 的每一格就是 [列][欄]</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🖼️</div><strong style='color:#166534;font-size:.9rem;'>圖片</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>數位影像是像素的二維陣列，每格存顏色值</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>♟️</div><strong style='color:#854d0e;font-size:.9rem;'>地圖與遊戲</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>棋盤、踩地雷、迷宮都是二維格子</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 📌 第 9 章的 <strong>Pandas DataFrame</strong> 就是「加上欄位名稱、功能超強」的二維表格。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 20, "title": "第四節 隨堂測驗", "chapter": "第四節：二維串列", "bg": "purple", "quiz": "q4", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第四節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>二維串列 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 21, "title": "本週實作", "chapter": "實作與總結", "bg": "white", "html": "<h2 class='slide-title'>✏️ 本週實作：Colab ＋ 線上練習</h2>\n<div style='display:flex;align-items:center;gap:14px;background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:12px 16px;margin-bottom:12px;'><div style='font-size:2rem;'>📓</div><div style='flex:1;'><strong style='color:#9a3412;font-size:.9rem;'>第 6 課 Colab 練習（6 題）</strong><div style='font-size:.78rem;color:#475569;margin-top:4px;line-height:1.6;'>索引小試身手、最高分、最低分、總和平均、成績單、等差數列<br>🔐 請用學校 Google 帳號登入才能開啟。</div></div><a href='https://colab.research.google.com/drive/1R0d79TQUo3Eu9kdCm3BOCMa5X1KwT1NF' target='_blank' rel='noopener' style='background:#f9ab00;color:#1f2937;font-weight:700;font-size:.82rem;padding:9px 16px;border-radius:20px;text-decoration:none;white-space:nowrap;'>在 Colab 開啟 ↗</a></div>\n<div style='background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:12px 16px;margin-bottom:12px;'><div style='display:flex;justify-content:space-between;align-items:center;gap:10px;'><strong style='color:#166534;font-size:.9rem;'>💻 線上練習（Online Judge）</strong><a href='http://103.226.213.97/course/view.php?id=2109' target='_blank' rel='noopener' style='background:#16a34a;color:#fff;font-weight:700;font-size:.78rem;padding:7px 14px;border-radius:18px;text-decoration:none;white-space:nowrap;'>前往練習網站 ↗</a></div><ul style='margin:8px 0 0 18px;font-size:.8rem;color:#334155;line-height:1.6;'><li style='margin-bottom:3px;'><strong>#401、#402</strong> 認識串列、串列的實作（測驗）</li><li style='margin-bottom:3px;'><strong>#403</strong> 計算最高銷售量（VPL）</li><li style='margin-bottom:3px;'><strong>#404</strong> 計算最高與最低銷售量（VPL）</li><li style='margin-bottom:3px;'><strong>#405</strong> 計算總銷量與平均銷量（VPL）</li><li style='margin-bottom:3px;'><strong>#406、#407</strong> 二維串列的表示、索引與元素（測驗）</li><li style='margin-bottom:3px;'><strong>#408</strong> 計算銷售總和（VPL）</li><li style='margin-bottom:3px;'><strong>#409</strong> Ch4 學習評量</li></ul><div style='font-size:.72rem;color:#64748b;margin-top:6px;'>課程：115芳和高中資訊科技Py ｜ VPL 題送出後系統會自動「評估」給分</div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 22, "title": "本週總結", "chapter": "實作與總結", "bg": "navy", "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 本週重點</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>串列</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>[ ] 裝一串資料；len() 取長度</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>索引</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>從 0 開始到 n−1；−1 是最後一個</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>打擂台</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>從第一個開始比，找最大最小</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>二維串列</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>c[i][j] 先列後行；雙重迴圈走訪</p></div></div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>「資料結構選對了，程式就簡單了一半。」</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一章：排序與搜尋——讓資料井然有序、一找就到</p>\n</div>\n", "quiz": null, "chart": null, "video": null}]